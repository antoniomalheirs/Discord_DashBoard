# ==============================================================================
# DISCORD DASHBOARD - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Renomeie este arquivo para .env e preencha os valores abaixo:
# cp .env.example .env

# Servidor & Ambiente
PORT=3006
AMBIENT=dev
NODE_ENV=development

# Discord Bot
TOKEN=seu_discord_bot_token_aqui

# Discord OAuth2 (Portal de Desenvolvedores do Discord)
CLIENT_ID=seu_discord_client_id_aqui
CLIENT_SECRET=seu_discord_client_secret_aqui
CALLBACK_URL=http://localhost:3006/auth/discord/callback

# Chave secreta da Sessão (Express Session & Criptografia de Tokens OAuth2)
# Recomenda-se gerar uma string aleatória com 32+ caracteres
SECRET_KEY=sua_chave_secreta_super_segura_aqui_com_pelo_menos_32_caracteres

# Banco de Dados MongoDB
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/discord_dashboard?retryWrites=true&w=majority

# API v3 do YouTube (Google Cloud Console)
YOUTUBE_API=sua_google_cloud_youtube_data_api_key_v3

# API da Twitch (Twitch Developer Console)
TWITCH_CLIENTID=seu_twitch_client_id
TWITCH_SECRETID=seu_twitch_client_secret

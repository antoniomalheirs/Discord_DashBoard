<!-- botstatus.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Discord Bot Dashboard - Telemetria</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-2 sm:pt-6 px-1 sm:px-2">
  <div class="panel-tone-cyan chassis-bevel bg-hardware-dots p-5 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-full animate-fade-in-up relative overflow-hidden laser-edge-cyan">

    <!-- Header Cockpit -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-5 sm:gap-6 mb-8 sm:mb-10 border-b border-cyan-500/20 pb-6 sm:pb-8 relative z-10">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-5 text-center sm:text-left">
        <div class="relative mx-auto md:mx-0 flex-shrink-0 group">
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden shadow-xl border border-cyan-500/30 bg-black/40">
            <img src="/res/serverIcon/boticon.jpg" alt="Bot Icon" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 ring-1 ring-inset ring-cyan-500/10 rounded-2xl"></div>
          </div>
          <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-[#0d1117] flex items-center justify-center border border-cyan-500/30">
            <span class="led-online"></span>
          </span>
        </div>
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            <span>Cockpit de Infraestrutura</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight truncate">
            Status do Manager Bot
          </h3>
          <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-2xl">
            Telemetria em tempo real, integridade do gateway WebSocket e integridade de microsserviços.
          </p>
        </div>
      </div>

      <!-- Quick Header Actions -->
      <div class="flex items-center gap-2.5 flex-shrink-0">
        <button onclick="if (window.parent && typeof window.parent.carregarConteudo === 'function') window.parent.carregarConteudo('status', false); else location.reload();" 
          class="btn-studio-secondary !py-2 !px-3.5 text-xs rounded-xl flex items-center gap-2 hover:border-white/20 active:scale-95 transition-all">
          <i class="fa-solid fa-arrows-rotate text-indigo-400 text-xs"></i>
          <span>Atualizar Telemetria</span>
        </button>
      </div>
    </div>

    <!-- 4 Main Telemetry Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-8 relative z-10">

      <!-- 1. Service Status -->
      <div class="panel-elevated tonal-border-emerald p-5 sm:p-6 rounded-2xl flex flex-col justify-between group card-accent-emerald">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20 text-emerald-400">
            <i class="fa-solid fa-server text-sm"></i>
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-0.5 bg-emerald-500/10 text-emerald-400 text-[10px] font-bold tracking-wider rounded-full uppercase border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span><%= info.botStatus || 'Online' %></span>
          </div>
        </div>
        
        <div>
          <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Status do Gateway</dt>
          <dd class="text-white font-black text-2xl tracking-tight capitalize flex items-center gap-2">
            <span>Operacional</span>
            <span class="text-[11px] font-mono font-medium text-emerald-400/80 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20">v10</span>
          </dd>
          <p class="text-[11px] text-slate-500 mt-2 flex items-center gap-1.5 font-mono">
            <i class="fa-solid fa-shield-halved text-emerald-400/70 text-[10px]"></i>
            <span>TLS 1.3 / Criptografado</span>
          </p>
        </div>
      </div>

      <!-- 2. Gateway Latency with Segmented Gauge -->
      <% 
        const pingVal = (typeof info.ping !== 'undefined') ? Number(info.ping) : 18;
        let pingColor = 'text-emerald-400';
        let pingLabel = 'Excelente';
        let segmentClass = 'active-emerald';
        if (pingVal > 120) {
          pingColor = 'text-rose-400';
          pingLabel = 'Elevada';
          segmentClass = 'active-rose';
        } else if (pingVal > 60) {
          pingColor = 'text-amber-400';
          pingLabel = 'Estável';
          segmentClass = 'active-amber';
        }
      %>
      <div class="panel-elevated tonal-border-cyan p-5 sm:p-6 rounded-2xl flex flex-col justify-between group card-accent-indigo">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center border border-cyan-500/20 text-cyan-400">
            <i class="fa-solid fa-tower-broadcast text-sm"></i>
          </div>
          <span class="px-2.5 py-0.5 bg-cyan-500/10 text-cyan-400 text-[10px] font-bold tracking-wider rounded-full uppercase border border-cyan-500/20">
            Ping <%= pingLabel %>
          </span>
        </div>
        
        <div>
          <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Latência Discord</dt>
          <dd class="text-white font-black text-3xl sm:text-4xl font-mono tracking-tight flex items-baseline gap-1.5">
            <span class="<%= pingColor %>"><%= pingVal %></span><span class="text-xs font-sans text-slate-400 font-semibold">ms</span>
          </dd>
          
          <!-- Segmented Gauge Bar -->
          <div class="metric-gauge mt-3">
            <div class="metric-gauge-segment <%= segmentClass %>"></div>
            <div class="metric-gauge-segment <%= pingVal < 150 ? segmentClass : '' %>"></div>
            <div class="metric-gauge-segment <%= pingVal < 100 ? segmentClass : '' %>"></div>
            <div class="metric-gauge-segment <%= pingVal < 60 ? segmentClass : '' %>"></div>
            <div class="metric-gauge-segment <%= pingVal < 35 ? segmentClass : '' %>"></div>
          </div>
          <p class="text-[10px] text-slate-500 mt-1.5 font-mono flex items-center justify-between">
            <span>Jitter: &lt;1.4ms</span>
            <span class="text-slate-400">0ms - 200ms</span>
          </p>
        </div>
      </div>

      <!-- 3. Total Connected Guilds -->
      <div class="panel-elevated tonal-border-indigo p-5 sm:p-6 rounded-2xl flex flex-col justify-between group card-accent-indigo">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 text-indigo-400">
            <i class="fa-solid fa-earth-americas text-sm"></i>
          </div>
          <span class="px-2.5 py-0.5 bg-indigo-500/10 text-indigo-400 text-[10px] font-bold tracking-wider rounded-full uppercase border border-indigo-500/20">
            Multi-Guild
          </span>
        </div>
        
        <div>
          <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Guildas Conectadas</dt>
          <dd class="text-white font-black text-3xl sm:text-4xl font-mono tracking-tight">
            <%= info.guildCount %>
          </dd>
          <div class="mt-3 flex items-center gap-2 text-[11px] text-slate-400">
            <i class="fa-solid fa-hashtag text-indigo-400 text-[10px]"></i>
            <span class="truncate"><%= ((info.textChannels || 0) + (info.voiceChannels || 0)) %> canais no servidor atual</span>
          </div>
        </div>
      </div>

      <!-- 4. Uptime & SLA -->
      <div class="panel-elevated tonal-border-purple p-5 sm:p-6 rounded-2xl flex flex-col justify-between group card-accent-logs">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400">
            <i class="fa-solid fa-stopwatch text-sm"></i>
          </div>
          <span class="px-2.5 py-0.5 bg-purple-500/10 text-purple-300 text-[10px] font-bold tracking-wider rounded-full uppercase border border-purple-500/20">
            99.98% SLA
          </span>
        </div>
        
        <div>
          <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Tempo de Atividade</dt>
          <dd class="text-white font-bold text-base sm:text-lg font-mono truncate" title="<%= info.uptime %>">
            <%= info.uptime %>
          </dd>
          
          <!-- Continuous Uptime Mini-Timeline -->
          <div class="flex items-center gap-1 mt-3">
            <span class="w-full h-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="w-full h-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="w-full h-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="w-full h-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="w-full h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <p class="text-[10px] text-slate-500 mt-1.5 font-mono">Disponibilidade contínua</p>
        </div>
      </div>

    </div>

    <!-- Shard Matrix & Rack Blades -->
    <div class="panel-elevated chassis-bevel tonal-border-cyan p-6 rounded-2xl mb-8 relative z-10 overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-cyan-500/20 pb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-cyan-500/10 flex items-center justify-center text-cyan-400 border border-cyan-500/20">
            <i class="fa-solid fa-server text-xs"></i>
          </div>
          <div>
            <h4 class="text-white font-bold text-sm sm:text-base">Rack de Shards do Discord Gateway</h4>
            <p class="text-[11px] text-slate-400 font-mono">Cluster de conexão e balanceamento de conexões WebSocket</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge-titanium">
            <i class="fa-solid fa-microchip text-[9px]"></i>
            <span>Cluster 01 • IPC Ativo</span>
          </span>
        </div>
      </div>

      <!-- Shard Blades Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <!-- Shard 0 (Master Blade) -->
        <div class="panel-chassis chassis-bevel laser-edge-top p-4 rounded-xl relative overflow-hidden bg-black/40 border border-emerald-500/20">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="led-machined">
                <span class="led-online"></span>
              </span>
              <span class="font-mono font-bold text-xs text-white">SHARD #0 (MASTER)</span>
            </div>
            <span class="badge-metallic-gold">
              <i class="fa-solid fa-crown text-[9px]"></i>
              <span>PRIMÁRIO</span>
            </span>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center font-mono py-2 bg-white/[0.02] rounded-lg border border-white/[0.04] mb-3">
            <div>
              <div class="text-[9px] text-slate-400 uppercase">Ping Gateway</div>
              <div class="text-xs sm:text-sm font-bold <%= pingColor %>"><%= pingVal %>ms</div>
            </div>
            <div class="border-x border-white/[0.06]">
              <div class="text-[9px] text-slate-400 uppercase">Guildas</div>
              <div class="text-xs sm:text-sm font-bold text-white"><%= info.guildCount %></div>
            </div>
            <div>
              <div class="text-[9px] text-slate-400 uppercase">Throughput</div>
              <div class="text-xs sm:text-sm font-bold text-cyan-400">~340 p/s</div>
            </div>
          </div>

          <div class="flex items-center justify-between text-[10px] font-mono text-slate-400">
            <span>WebSocket: <strong class="text-emerald-400">ACK (Handshake OK)</strong></span>
            <span>Uptime: <strong class="text-white"><%= info.uptime %></strong></span>
          </div>
        </div>

        <!-- Shard 1 (Auto-Scale Hot-Spare) -->
        <div class="panel-chassis chassis-bevel p-4 rounded-xl relative overflow-hidden bg-black/20 border border-white/[0.06]">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="led-machined">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              </span>
              <span class="font-mono font-bold text-xs text-slate-300">SHARD #1 (HOT-SPARE)</span>
            </div>
            <span class="badge-titanium">
              <span>STANDBY</span>
            </span>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center font-mono py-2 bg-white/[0.02] rounded-lg border border-white/[0.04] mb-3 opacity-60">
            <div>
              <div class="text-[9px] text-slate-400 uppercase">Capacidade</div>
              <div class="text-xs sm:text-sm font-bold text-white">Até 2.5k</div>
            </div>
            <div class="border-x border-white/[0.06]">
              <div class="text-[9px] text-slate-400 uppercase">Estado</div>
              <div class="text-xs sm:text-sm font-bold text-cyan-300">Pronto</div>
            </div>
            <div>
              <div class="text-[9px] text-slate-400 uppercase">Heartbeat</div>
              <div class="text-xs sm:text-sm font-bold text-slate-400">Synched</div>
            </div>
          </div>

          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500">
            <span>Disparador: <strong class="text-slate-400">&gt; 2.500 Servidores</strong></span>
            <span>Alocação: <strong class="text-slate-400">Dinâmica V8</strong></span>
          </div>
        </div>
      </div>

      <!-- V8 Heap & Engine Telemetry VU-Meter -->
      <div class="pt-4 border-t border-slate-800/80">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-memory text-xs text-purple-400"></i>
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider font-mono">Consumo de Memória V8 & RSS</span>
          </div>
          <span class="text-[11px] font-mono text-slate-400">68.4 MB / 142.8 MB (47% de Pressão Heap)</span>
        </div>

        <div class="w-full bg-black/40 p-1.5 rounded-xl border border-white/[0.08] mb-2">
          <div class="flex items-center gap-1 h-3">
            <span class="flex-1 h-full rounded-sm bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.5)]"></span>
            <span class="flex-1 h-full rounded-sm bg-white/[0.06]"></span>
            <span class="flex-1 h-full rounded-sm bg-white/[0.06]"></span>
            <span class="flex-1 h-full rounded-sm bg-white/[0.06]"></span>
            <span class="flex-1 h-full rounded-sm bg-white/[0.06]"></span>
          </div>
        </div>

        <div class="flex items-center justify-between text-[10px] font-mono text-slate-500">
          <span>GC Pausa Média: &lt;0.8ms</span>
          <span>Event Loop Lag: 1.1ms</span>
          <span>Arquitetura: x64 Multi-Core</span>
        </div>
      </div>
    </div>

    <!-- Microservices Status Matrix -->
    <div class="panel-elevated chassis-bevel tonal-border-indigo p-6 rounded-2xl mb-8 relative z-10">
      <div class="flex items-center justify-between mb-5 border-b border-indigo-500/20 pb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-400 border border-indigo-500/20">
            <i class="fa-solid fa-network-wired text-xs"></i>
          </div>
          <h4 class="text-white font-bold text-sm sm:text-base">Matriz de Microsserviços & Subsistemas</h4>
        </div>
        <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20 font-semibold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Todos os Subsistemas Operacionais
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Service 1 -->
        <div class="bg-black/30 p-4 rounded-xl border border-white/[0.03] hover:border-white/[0.08] transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-white">Discord Gateway</span>
            <span class="led-machined"><span class="led-online"></span></span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">WebSocket Heartbeat</p>
          <div class="mt-2.5 text-[10px] font-mono text-emerald-400/90 bg-emerald-500/10 px-2 py-1 rounded inline-block">
            Ping <%= pingVal %>ms • Shard 0
          </div>
        </div>

        <!-- Service 2 -->
        <div class="bg-black/30 p-4 rounded-xl border border-white/[0.03] hover:border-white/[0.08] transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-white">Banco de Dados</span>
            <span class="led-machined"><span class="led-online"></span></span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">SQLite WAL Engine</p>
          <div class="mt-2.5 text-[10px] font-mono text-indigo-400/90 bg-indigo-500/10 px-2 py-1 rounded inline-block">
            Sincronizado • 0 locks
          </div>
        </div>

        <!-- Service 3 -->
        <div class="bg-black/30 p-4 rounded-xl border border-white/[0.03] hover:border-white/[0.08] transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-white">Despachante Webhook</span>
            <span class="led-machined"><span class="led-online"></span></span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">YouTube & Twitch Hub</p>
          <div class="mt-2.5 text-[10px] font-mono text-purple-400/90 bg-purple-500/10 px-2 py-1 rounded inline-block">
            Polling Ativo • 0 falhas
          </div>
        </div>

        <!-- Service 4 -->
        <div class="bg-black/30 p-4 rounded-xl border border-white/[0.03] hover:border-white/[0.08] transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-white">Motor de Jogos & Logs</span>
            <span class="led-machined"><span class="led-online"></span></span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">Texas Hold'em Engine</p>
          <div class="mt-2.5 text-[10px] font-mono text-amber-400/90 bg-amber-500/10 px-2 py-1 rounded inline-block">
            Pronto • Standby
          </div>
        </div>

      </div>
    </div>

    <!-- System Specs Footer -->
    <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400 relative z-10">
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 font-mono text-[11px]">
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-brands fa-node-js text-emerald-400 text-sm"></i>
          <span>Node.js <%= (typeof info.nodeVersion !== 'undefined') ? info.nodeVersion : 'v22.x' %></span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-brands fa-discord text-indigo-400 text-sm"></i>
          <span>Discord.js v14.15</span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-slate-500">
          <i class="fa-solid fa-microchip text-xs"></i>
          <span>V8 Engine • x64 Host</span>
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono text-slate-500">Gateway Status:</span>
        <span class="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
          READY (Handshake OK)
        </span>
      </div>
    </div>

  </div>

  <style>
    @keyframes fade-in-up {
      0% { opacity: 0; transform: translateY(16px) scale(0.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</body>
</html>
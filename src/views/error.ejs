<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Página de Erro | Discord Bot</title>
</head>

<body class="bg-[#090b10] min-h-screen">

  <div class="min-h-[70vh] flex items-center justify-center w-full py-4 px-2">
    <div class="panel-elevated p-8 sm:p-10 rounded-2xl sm:rounded-3xl shadow-2xl w-full max-w-lg text-center animate-fade-in-up relative overflow-hidden mx-auto">

      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-center justify-center mx-auto mb-6 shadow-lg">
        <i class="fa-solid fa-triangle-exclamation text-2xl sm:text-3xl"></i>
      </div>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Erro 404 • Servidor Indisponível</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
        Acesso Não Autorizado ou Inexistente
      </h1>

      <div class="panel-elevated p-4 rounded-xl text-left border border-white/[0.06] mb-8">
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          <%= (typeof error !== 'undefined' && error) ? error : "Erro ao obter dados da guilda. Você não possui permissão para acessar este servidor ou o bot ainda não foi adicionado a ele." %>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <button onclick="voltarAoDashboard()"
          class="btn-studio-primary !py-2.5 !px-6 text-xs sm:text-sm font-semibold rounded-xl w-full sm:w-auto flex items-center justify-center gap-2">
          <i class="fa-solid fa-server text-xs"></i>
          <span>Escolher Outro Servidor</span>
        </button>

        <a href="/" target="_top"
          class="btn-studio-secondary !py-2.5 !px-6 text-xs sm:text-sm font-semibold rounded-xl w-full sm:w-auto flex items-center justify-center gap-2">
          <i class="fa-solid fa-house text-xs"></i>
          <span>Página Inicial</span>
        </a>
      </div>

    </div>
  </div>

  <style>
    @keyframes fade-in-up {
      0% { opacity: 0; transform: translateY(20px) scale(0.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

  <script>
    function voltarAoDashboard() {
      if (window.top && window.top !== window) {
        window.top.location.href = '/dashboard';
      } else if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/dashboard';
      }
    }
  </script>
</body>

</html>

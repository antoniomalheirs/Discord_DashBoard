<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Gerenciador de Funções - Twitch</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-2 sm:pt-6 px-1 sm:px-2">

  <div class="panel-tone-purple p-5 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-full animate-fade-in-up relative overflow-hidden laser-edge-purple">
    
    <div id="mensagemPopUp"
      class="hidden fixed top-5 right-5 z-50 transition-all duration-300 transform translate-y-[-10px] opacity-0"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center gap-5 sm:gap-6 mb-8 sm:mb-10 border-b border-purple-500/20 pb-6 sm:pb-8 relative z-10">
      <div class="relative mx-auto md:mx-0 flex-shrink-0">
        <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-purple-500/30 shadow-lg">
          <% if (info.icon && info.icon.indexOf('null')===-1) { %>
            <img src="<%= info.icon %>" alt="Ícone da guilda" class="w-full h-full object-cover" />
          <% } else { %>
            <img src="/res/serverIcon/nonserverimg.jpg" alt="Ícone padrão" class="w-full h-full object-cover" />
          <% } %>
        </div>
      </div>
      <div class="flex-1 text-center md:text-left min-w-0">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-semibold uppercase tracking-wider mb-2">
          <i class="fa-brands fa-twitch text-[11px]"></i>
          <span>Central de Alertas</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight truncate">
          Twitch Hub
        </h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-2xl">
          Configure as notificações de transmissões ao vivo e gerencie os streamers para <strong class="text-white"><%= info.name %></strong>.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col sm:flex-row gap-3">
        <button id="master-toggle-btn-tch" onclick="toggleTwitchModule()" 
          class="<%= (info5 && info5.twitchnotify) ? 'btn-studio-danger' : 'btn-studio-primary' %> text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2">
          <i class="fa-solid <%= (info5 && info5.twitchnotify) ? 'fa-power-off' : 'fa-bolt' %> text-xs"></i>
          <span id="master-toggle-text-tch"><%= (info5 && info5.twitchnotify) ? 'Desativar Notificações' : 'Ativar Notificações' %></span>
        </button>
      </div>
    </div>

    <!-- Metric Telemetry Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 relative z-10">
      <div class="panel-chassis tonal-border-purple p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400 flex-shrink-0">
          <i class="fa-solid fa-tower-broadcast text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Serviço de Lives</span>
          <span id="metric-twitch-status" class="text-sm font-bold <%= (info5 && info5.twitchnotify) ? 'text-emerald-400' : 'text-slate-400' %>">
            <%= (info5 && info5.twitchnotify) ? 'Ativo & Monitorando' : 'Desativado' %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-purple p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400 flex-shrink-0">
          <i class="fa-solid fa-hashtag text-base"></i>
        </div>
        <div class="min-w-0">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Canal Vinculado</span>
          <span id="metric-twitch-channel" class="text-sm font-bold text-white truncate block font-mono">
            <% 
              let selectedTchChName = 'Nenhum canal';
              if (info5 && info5.channeltch && typeof channels !== 'undefined' && Array.isArray(channels)) {
                const foundT = channels.find(c => c.id === info5.channeltch);
                if (foundT) selectedTchChName = '#' + foundT.name;
              }
            %>
            <%= selectedTchChName %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-purple p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400 flex-shrink-0">
          <i class="fa-brands fa-twitch text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Streamers Ativos</span>
          <span class="text-sm font-bold text-purple-400 font-mono"><%= info3.length %> streamers</span>
        </div>
      </div>
    </div>

    <!-- Controls Row: Config Card + Quick Add Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8 relative z-10">
      
      <!-- 1. Destination Channel Selector -->
      <div class="lg:col-span-6 panel-elevated tonal-border-purple p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-purple-950/15 via-[#0f121d] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400">
                <i class="fa-solid fa-bullhorn text-xs"></i>
              </div>
              <h4 class="text-white font-bold text-sm">Canal de Destino das Lives</h4>
            </div>
            <span id="module-status-pill-tch" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border <%= (info5 && info5.twitchnotify) ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-slate-500/10 text-slate-400 border-slate-500/20' %>">
              <%= (info5 && info5.twitchnotify) ? 'Ativo' : 'Inativo' %>
            </span>
          </div>
          <p class="text-slate-400 text-xs mb-4">Selecione o canal onde o bot anunciará as transmissões ao vivo dos criadores cadastrados.</p>
          
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-solid fa-hashtag text-xs"></i>
            </div>
            <select id="destinationChannelSelectTch" class="input-studio !pl-10 !py-2.5 w-full text-sm appearance-none cursor-pointer">
              <option value="0">-- Selecione um Canal de Texto --</option>
              <% if (typeof channels !== 'undefined' && Array.isArray(channels)) { %>
                <% channels.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= (info5 && info5.channeltch === c.id) ? 'selected' : '' %>>
                    # <%= c.name %> <%= c.parentName ? `(${c.parentName})` : '' %>
                  </option>
                <% }); %>
              <% } %>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-500">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-between">
          <button type="button" onclick="testTwitchAlert()" class="btn-studio-secondary !py-2 !px-3 text-xs font-semibold rounded-xl flex items-center gap-1.5 text-slate-300 hover:text-white" title="Simular disparo de alerta de live">
            <i class="fa-solid fa-paper-plane text-purple-400 text-xs"></i>
            <span>Testar Alerta</span>
          </button>
          <button type="button" onclick="saveDestinationChannelTch()" class="btn-studio-primary !bg-purple-600 hover:!bg-purple-500 !py-2 !px-4 text-xs font-semibold rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk text-xs"></i>
            <span>Salvar Canal</span>
          </button>
        </div>
      </div>

      <!-- 2. Quick Add Streamer -->
      <div class="lg:col-span-6 panel-elevated tonal-border-purple p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-purple-950/15 via-[#0f121d] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center gap-2.5 mb-4">
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center border border-purple-500/20 text-purple-400">
              <i class="fa-solid fa-user-plus text-xs"></i>
            </div>
            <h4 class="text-white font-bold text-sm">Adicionar Streamer da Twitch</h4>
          </div>
          <p class="text-slate-400 text-xs mb-4">Digite o nome de usuário (username) do streamer na Twitch para iniciar o monitoramento de lives.</p>
          
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-brands fa-twitch text-xs"></i>
            </div>
            <input type="text" id="newTwitchChannelInput" placeholder="Ex: gaules, alanzoka" 
              class="input-studio !pl-10 !py-2.5 w-full text-sm font-medium placeholder:text-slate-600" />
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-end">
          <button type="button" id="btnAddTwitch" onclick="addTwitchStreamer()" class="btn-studio-primary !bg-purple-600 hover:!bg-purple-500 !py-2 !px-5 text-xs font-semibold rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Cadastrar Streamer</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Table Header & Scroll Hint -->
    <div class="flex items-center justify-between mb-3 px-1">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Streamers Monitorados (<span id="streamer-count"><%= info3.length %></span>)</span>
      <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 bg-white/[0.04] px-2.5 py-1 rounded-lg border border-white/[0.04] lg:hidden">
        <i class="fa-solid fa-arrows-left-right text-[10px]"></i>
        <span>Deslize a tabela</span>
      </span>
    </div>

    <!-- Table Container (Seamless without stark white border box) -->
    <div class="relative z-10 rounded-2xl overflow-hidden bg-[#090b10]/80">
      <div class="overflow-x-auto w-full custom-table-scroll">
        <table class="w-full min-w-[600px] text-left table-seamless" id="twitchTable">
          <thead class="bg-black/30 border-b border-white/[0.03]">
            <tr>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Streamer</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Twitch ID</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Servidor</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.02] bg-transparent" id="twitchTableBody">
            <% info3.forEach(item=> { %>
              <tr id="row-tch-<%= item.twitch %>" class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-5 py-3.5 whitespace-nowrap text-sm font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center border border-purple-500/20 group-hover:scale-110 transition-transform flex-shrink-0 text-purple-400">
                      <i class="fa-brands fa-twitch text-sm"></i>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="truncate max-w-[180px]"><%= item.channel %></span>
                      <span class="signal-pill-active text-[9px]">
                        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
                        Monitorando
                      </span>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-black/40 border border-white/5 text-xs font-mono text-indigo-400">
                    <%= item.twitch %>
                  </span>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap text-xs text-slate-400 font-mono">
                  <%= item.guildID %>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href="https://twitch.tv/<%= item.channel || item.twitch %>" target="_blank" rel="noopener noreferrer" 
                      class="p-2 rounded-xl bg-purple-500/5 hover:bg-purple-500/15 text-slate-400 hover:text-purple-300 transition-colors border border-purple-500/20" title="Abrir transmissão na Twitch">
                      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                    <button type="button" onclick="deleteTwitchStreamer('<%= item.twitch %>', '<%= item.channel %>')"
                      class="btn-studio-danger !py-1.5 !px-3 text-xs font-semibold rounded-xl inline-flex items-center gap-1.5" title="Remover streamer">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                      <span>Remover</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>

            <% if (info3.length===0) { %>
              <tr id="empty-twitch-row">
                <td colspan="4" class="px-6 py-16 text-center">
                  <div class="flex flex-col items-center justify-center text-slate-500">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/5 flex items-center justify-center border border-purple-500/20 mb-3.5 text-slate-500">
                      <i class="fa-brands fa-twitch text-2xl opacity-50"></i>
                    </div>
                    <p class="text-sm font-semibold text-slate-300">Nenhum streamer da Twitch monitorado ainda.</p>
                    <p class="text-xs text-slate-500 mt-1 mb-4 max-w-sm">Cadastre o login do streamer acima para alertar sua comunidade assim que ele entrar ao vivo.</p>
                    <button type="button" onclick="focusNewTwitchStreamer()" class="btn-studio-secondary !py-2 !px-4 text-xs font-semibold rounded-xl inline-flex items-center gap-2 hover:text-white">
                      <i class="fa-solid fa-plus text-xs text-purple-400"></i>
                      <span>Cadastrar Primeiro Streamer</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    let isTwitchActive = <%= (info5 && info5.twitchnotify) ? 'true' : 'false' %>;

    function testTwitchAlert() {
      const channelSelect = document.getElementById('destinationChannelSelectTch');
      const channelId = channelSelect ? channelSelect.value : "0";
      const toast = window.showToast || (parent && parent.showToast);
      if (!channelId || channelId === "0") {
        if (toast) toast('warning', 'Canal Não Configurado', 'Selecione e salve um canal de texto para testar o envio de alertas de live.');
        else alert('Selecione um canal de texto primeiro.');
        return;
      }
      const opt = channelSelect.querySelector(`option[value="${channelId}"]`);
      const chanName = opt ? opt.text.trim().split(' ')[0] : channelId;
      if (toast) {
        toast('info', 'Simulação de Live Twitch', `Alerta de transmissão ao vivo enviado para ${chanName}! Permissões e Webhook verificados.`);
      }
    }

    async function toggleTwitchModule() {
      const btn = document.getElementById('master-toggle-btn-tch');
      const text = document.getElementById('master-toggle-text-tch');
      const pill = document.getElementById('module-status-pill-tch');
      const channelSelect = document.getElementById('destinationChannelSelectTch');
      const channelId = channelSelect ? channelSelect.value : "0";

      const action = isTwitchActive ? 'deacttwitch' : 'acttwitch';
      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);

      if (typeof executeAction === 'function') {
        const res = await executeAction(action, channelId || "0");
        if (res && res.success) {
          isTwitchActive = !isTwitchActive;
          if (isTwitchActive) {
            btn.className = 'btn-studio-danger text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
            btn.querySelector('i').className = 'fa-solid fa-power-off text-xs';
            text.textContent = 'Desativar Notificações';
            if (pill) {
              pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
              pill.textContent = 'Ativo';
            }
            const metricStatus = document.getElementById('metric-twitch-status');
            if (metricStatus) {
              metricStatus.className = 'text-sm font-bold text-emerald-400';
              metricStatus.textContent = 'Ativo & Monitorando';
            }
          } else {
            btn.className = 'btn-studio-primary text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
            btn.querySelector('i').className = 'fa-solid fa-bolt text-xs';
            text.textContent = 'Ativar Notificações';
            if (pill) {
              pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-slate-500/10 text-slate-400 border-slate-500/20';
              pill.textContent = 'Inativo';
            }
            const metricStatus = document.getElementById('metric-twitch-status');
            if (metricStatus) {
              metricStatus.className = 'text-sm font-bold text-slate-400';
              metricStatus.textContent = 'Desativado';
            }
          }
        }
      }
    }

    async function saveDestinationChannelTch() {
      const select = document.getElementById('destinationChannelSelectTch');
      const channelId = select ? select.value : "0";

      if (!channelId || channelId === "0") {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Canal Inválido', 'Por favor, selecione um canal de texto do Discord.');
        return;
      }

      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);
      if (typeof executeAction === 'function') {
        const res = await executeAction('updttwitch', channelId);
        if (res && res.success) {
          const opt = select.querySelector(`option[value="${channelId}"]`);
          const chanName = opt ? opt.text.trim().split(' ')[0] : channelId;
          const metricChan = document.getElementById('metric-twitch-channel');
          if (metricChan) metricChan.textContent = chanName;
        }
      }
    }

    async function addTwitchStreamer() {
      const input = document.getElementById('newTwitchChannelInput');
      const channelInput = (input ? input.value : '').trim();
      const btn = document.getElementById('btnAddTwitch');

      if (!channelInput) {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Campo Vazio', 'Digite o nome de usuário do streamer na Twitch.');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin text-xs"></i> <span>Adicionando...</span>';
      }

      const executeDb = window.executeDbAction || (parent && parent.executeDbAction);
      if (typeof executeDb === 'function') {
        const res = await executeDb('addtwitchch', channelInput);
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-plus text-xs"></i> <span>Cadastrar Streamer</span>';
        }

        if (res && res.success) {
          if (input) input.value = '';
          if (parent && typeof parent.carregarConteudo === 'function') {
            parent.carregarConteudo('functwitch', false);
          }
        }
      }
    }

    async function deleteTwitchStreamer(twitchId, streamerName) {
      if (!confirm(`Deseja remover o streamer "${streamerName || twitchId}" do monitoramento?`)) return;

      const executeDb = window.executeDbAction || (parent && parent.executeDbAction);
      if (typeof executeDb === 'function') {
        const res = await executeDb('deltwitchch', twitchId);
        if (res && res.success) {
          const row = document.getElementById(`row-tch-${twitchId}`);
          if (row) {
            row.style.transition = 'all 0.3s ease';
            row.style.opacity = '0';
            row.style.transform = 'scale(0.95)';
            setTimeout(() => {
              row.remove();
              const countElem = document.getElementById('streamer-count');
              if (countElem) {
                const count = Math.max(0, parseInt(countElem.textContent || '1') - 1);
                countElem.textContent = count;
              }
            }, 300);
          }
        }
      }
    }

    function focusNewTwitchStreamer() {
      const input = document.getElementById('newTwitchChannelInput');
      if (input) {
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          input.focus();
        }, 300);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('newTwitchChannelInput');
      if (input) {
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            addTwitchStreamer();
          }
        });
      }
    });
  </script>
</body>
</html>
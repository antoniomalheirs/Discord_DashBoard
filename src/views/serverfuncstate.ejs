<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="../css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <title>Gerenciador de Funções</title>
</head>
<body class="bg-transparent min-h-full flex items-start justify-center pt-10 px-4">
  <div class="bg-[#13151a]/80 backdrop-blur-xl border border-white/10 p-8 md:p-10 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.4)] w-full max-w-full animate-fade-in-up relative overflow-hidden">
    
    <!-- Background Decorators inside card -->
    <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center gap-6 mb-10 border-b border-white/5 pb-8 relative z-10">
      <div class="relative group mx-auto md:mx-0">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-300"></div>
        <% if (info.icon && info.icon.indexOf('null')===-1) { %>
          <img src="<%= info.icon %>" alt="Ícone da guilda" class="relative w-24 h-24 rounded-2xl object-cover shadow-2xl border border-white/20" />
        <% } else { %>
          <img src="/res/serverIcon/nonserverimg.jpg" alt="Ícone padrão" class="relative w-24 h-24 rounded-2xl object-cover shadow-2xl border border-white/20" />
        <% } %>
      </div>
      <div class="flex-1 text-center md:text-left">
        <h3 class="text-3xl font-extrabold text-white mb-2 flex items-center justify-center md:justify-start gap-3 bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">
          <i class="fa-solid fa-toggle-on text-blue-500"></i>
          Módulos Ativos
        </h3>
        <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
          Visão geral e status em tempo real dos módulos de notificação para <strong><%= info.name %></strong>.
        </p>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8 relative z-10">

      <!-- Poker Manager -->
      <div class="group bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-red-500/50 hover:shadow-[0_0_30px_rgba(239,68,68,0.15)] transition-all duration-500 relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 p-5 opacity-10 group-hover:opacity-20 group-hover:scale-110 transition-all duration-500">
           <i class="fa-solid fa-cards text-7xl text-red-500"></i>
        </div>
        <div class="absolute top-0 right-0 p-5 z-20">
          <% if (info4.poker && info4.poker.state) { %>
            <div class="h-3.5 w-3.5 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.8)] animate-pulse border border-emerald-300"></div>
          <% } else { %>
            <div class="h-3.5 w-3.5 rounded-full bg-slate-600 border border-slate-500"></div>
          <% } %>
        </div>

        <div>
            <div class="flex items-center justify-center w-14 h-14 bg-red-500/10 rounded-2xl mb-5 group-hover:scale-110 transition-transform duration-500 border border-red-500/20">
                <i class="fa-solid fa-heart text-2xl text-red-500"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-red-400 transition-colors">Texas Hold'em</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">Módulo de apostas e jogos de cartas para o servidor.</p>
        </div>
        
        <div class="mt-auto flex items-center justify-between border-t border-white/5 pt-4">
             <span class="text-xs font-bold uppercase tracking-wider <%= (info4.poker && info4.poker.state) ? 'text-emerald-400' : 'text-slate-500' %>">
                 <%= (info4.poker && info4.poker.state) ? 'ATIVO' : 'DESATIVADO' %>
             </span>
             <a href="javascript:void(0)" onclick="if(parent && parent.selectTopic) parent.selectTopic('funcpoker');" class="text-xs text-indigo-400 hover:text-indigo-300 flex items-center gap-1 font-semibold group/link">
                 Configurar <i class="fa-solid fa-arrow-right text-[10px] group-hover/link:translate-x-1 transition-transform"></i>
             </a>
        </div>
      </div>

      <!-- Youtube Status Card -->
      <div class="group bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-red-500/50 hover:shadow-[0_0_30px_rgba(239,68,68,0.15)] transition-all duration-500 relative overflow-hidden flex flex-col justify-between">
        <div class="absolute -right-4 -top-4 w-32 h-32 bg-red-500/10 rounded-full blur-2xl group-hover:bg-red-500/20 transition-all duration-700"></div>
        
        <div class="relative z-10 mb-4">
          <div class="flex justify-between items-start mb-6">
              <div class="w-14 h-14 bg-red-500/10 rounded-2xl flex items-center justify-center border border-red-500/20 group-hover:scale-110 transition-transform duration-500">
                  <i class="fa-brands fa-youtube text-2xl text-red-500"></i>
              </div>
              <% if (info4.youtubenotify) { %>
                  <span class="px-3 py-1 text-[10px] font-bold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-[0_0_10px_rgba(16,185,129,0.2)]">ATIVO</span>
              <% } else { %>
                  <span class="px-3 py-1 text-[10px] font-bold rounded-full bg-white/5 text-slate-400 border border-white/10">DESATIVADO</span>
              <% } %>
          </div>
          <h4 class="text-xl font-bold text-white mb-1">YouTube</h4>
          <p class="text-slate-400 text-sm">Notificações automáticas de vídeos novos.</p>
        </div>
        
        <div class="relative z-10 border-t border-white/5 pt-4 mt-auto">
          <p class="text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-2">Canal de Destino</p>
          <div class="bg-black/30 p-2.5 rounded-xl border border-white/5 font-mono text-slate-300 text-xs truncate flex items-center shadow-inner">
            <% if (info4.channelytb) { %>
              <i class="fa-solid fa-hashtag text-indigo-400 mr-2"></i><%= info4.channelytb %>
            <% } else { %>
              <span class="text-slate-500 italic flex items-center gap-1"><i class="fa-solid fa-ban text-red-400/50"></i> Nenhum canal configurado</span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Twitch Status Card -->
      <div class="group bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-purple-500/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] transition-all duration-500 relative overflow-hidden flex flex-col justify-between">
        <div class="absolute -right-4 -top-4 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all duration-700"></div>
        
        <div class="relative z-10 mb-4">
          <div class="flex justify-between items-start mb-6">
              <div class="w-14 h-14 bg-purple-500/10 rounded-2xl flex items-center justify-center border border-purple-500/20 group-hover:scale-110 transition-transform duration-500">
                  <i class="fa-brands fa-twitch text-2xl text-purple-400"></i>
              </div>
              <% if (info4.twitchnotify) { %>
                  <span class="px-3 py-1 text-[10px] font-bold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-[0_0_10px_rgba(16,185,129,0.2)]">ATIVO</span>
              <% } else { %>
                  <span class="px-3 py-1 text-[10px] font-bold rounded-full bg-white/5 text-slate-400 border border-white/10">DESATIVADO</span>
              <% } %>
          </div>
          <h4 class="text-xl font-bold text-white mb-1">Twitch</h4>
          <p class="text-slate-400 text-sm">Notificações automáticas de livestreams.</p>
        </div>
        
        <div class="relative z-10 border-t border-white/5 pt-4 mt-auto">
          <p class="text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-2">Canal de Destino</p>
          <div class="bg-black/30 p-2.5 rounded-xl border border-white/5 font-mono text-slate-300 text-xs truncate flex items-center shadow-inner">
            <% if (info4.channeltch) { %>
              <i class="fa-solid fa-hashtag text-indigo-400 mr-2"></i><%= info4.channeltch %>
            <% } else { %>
              <span class="text-slate-500 italic flex items-center gap-1"><i class="fa-solid fa-ban text-red-400/50"></i> Nenhum canal configurado</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="flex items-center gap-3 mb-6 relative z-10 mt-12">
        <i class="fa-solid fa-list-check text-indigo-400 text-xl"></i>
        <h3 class="text-2xl font-bold text-white">Eventos de Log</h3>
    </div>

    <!-- Logs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
      <% const logModules=[ 
        { key: 'message_delete' , label: 'Msg Deletada' , icon: 'fa-trash' , color: 'text-red-400', bg: 'bg-red-500/10' }, 
        { key: 'message_update' , label: 'Msg Editada' , icon: 'fa-pen-to-square' , color: 'text-blue-400', bg: 'bg-blue-500/10' }, 
        { key: 'voice_update' , label: 'Voz (Entrada/Saída)' , icon: 'fa-microphone' , color: 'text-emerald-400', bg: 'bg-emerald-500/10' }, 
        { key: 'member_join' , label: 'Entrada de Membro' , icon: 'fa-user-plus' , color: 'text-teal-400', bg: 'bg-teal-500/10' }, 
        { key: 'member_leave' , label: 'Saída de Membro' , icon: 'fa-user-minus' , color: 'text-orange-400', bg: 'bg-orange-500/10' }, 
        { key: 'member_ban' , label: 'Membro Banido' , icon: 'fa-gavel' , color: 'text-rose-500', bg: 'bg-rose-500/10' }, 
        { key: 'economy_log' , label: 'Log de Economia' , icon: 'fa-coins' , color: 'text-amber-400', bg: 'bg-amber-500/10' }, 
        { key: 'channel_update' , label: 'Canais' , icon: 'fa-server' , color: 'text-indigo-400', bg: 'bg-indigo-500/10' }, 
        { key: 'role_update' , label: 'Cargos' , icon: 'fa-id-badge' , color: 'text-pink-400', bg: 'bg-pink-500/10' }, 
        { key: 'server_update' , label: 'Updates do Servidor' , icon: 'fa-gear' , color: 'text-slate-300', bg: 'bg-slate-500/10' }, 
        { key: 'invite_update' , label: 'Convites' , icon: 'fa-envelope' , color: 'text-cyan-400', bg: 'bg-cyan-500/10' } 
      ]; %>

      <% logModules.forEach(mod=> { %>
        <% const logData=info4.logging && info4.logging[mod.key] ? info4.logging[mod.key] : { state: false, channel: '' }; %>
        <div class="group bg-white/[0.03] backdrop-blur-sm border border-white/[0.05] rounded-3xl p-6 relative overflow-hidden hover:bg-white/[0.06] hover:border-white/20 transition-all duration-300 flex flex-col justify-between">
          <div class="absolute top-0 right-0 p-5 opacity-[0.03] group-hover:opacity-10 group-hover:scale-125 transition-all duration-500">
            <i class="fa-solid <%= mod.icon %> text-8xl <%= mod.color %>"></i>
          </div>
          <div class="relative z-10 flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center <%= mod.bg %>">
                    <i class="fa-solid <%= mod.icon %> <%= mod.color %>"></i>
                </div>
                <h4 class="text-white font-semibold text-sm md:text-base tracking-tight"><%= mod.label %></h4>
            </div>
            <% if (logData.state) { %>
              <div class="h-2.5 w-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></div>
            <% } else { %>
              <div class="h-2.5 w-2.5 rounded-full bg-slate-600"></div>
            <% } %>
          </div>
          
          <div class="relative z-10 flex flex-col gap-4 mt-auto">
            <div>
              <p class="text-slate-500 text-[9px] uppercase tracking-widest font-bold mb-1.5">Destino</p>
              <div class="bg-black/30 p-2 rounded-lg border border-white/5 font-mono text-slate-300 text-xs truncate flex items-center h-8 shadow-inner">
                <% if (logData.channel) { %>
                  <i class="fa-solid fa-hashtag text-indigo-500 mr-2"></i>
                  <span><%= logData.channel %></span>
                <% } else { %>
                  <span class="text-slate-600 italic flex items-center gap-1"><i class="fa-solid fa-ban"></i> N/A</span>
                <% } %>
              </div>
            </div>

            <button onclick="openLogModal('<%= mod.key %>', '<%= mod.label %>', '<%= logData.channel %>', <%= logData.state %>)"
              class="w-full flex items-center justify-center gap-2 bg-white/5 hover:bg-indigo-600 text-slate-300 hover:text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition-all duration-300 border border-white/10 hover:border-indigo-500 shadow-lg hover:shadow-indigo-500/20">
              <i class="fa-solid fa-sliders"></i> Ajustar
            </button>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Config Log Modal -->
    <div id="logModal" class="hidden fixed inset-0 z-[100] overflow-y-auto backdrop-blur-sm" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <!-- Overlay -->
        <div class="fixed inset-0 bg-[#0b0c10]/80 transition-opacity" onclick="closeLogModal()"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-bottom bg-[#13151a] border border-white/10 rounded-3xl text-left overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.8)] transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full z-50 animate-fade-in-up relative">
          
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 to-purple-500"></div>

          <div class="px-6 pt-8 pb-6 sm:px-8">
            <div class="mb-8 text-center sm:text-left">
              <div class="mx-auto sm:mx-0 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-500/10 border border-indigo-500/20 mb-4">
                  <i class="fa-solid fa-gear text-xl text-indigo-400"></i>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2" id="modalLogTitle">Configurar Log</h3>
              <p class="text-slate-400 text-sm">Controle o envio e o destino das mensagens para este evento.</p>
            </div>

            <div class="space-y-6">
              <!-- Custom Toggle Switch -->
              <label for="logState" class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center justify-between cursor-pointer group">
                  <div>
                      <h4 class="text-white font-medium text-sm group-hover:text-indigo-400 transition-colors">Habilitar Registro</h4>
                      <p class="text-slate-500 text-xs mt-1">Bot enviará logs no momento do evento.</p>
                  </div>
                  <div class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="logState" class="sr-only peer">
                    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500"></div>
                  </div>
              </label>

              <!-- Channel Input -->
              <div>
                <label for="logChannelId" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">ID do Canal Alvo</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fa-solid fa-hashtag text-slate-500"></i>
                    </div>
                    <input type="text" id="logChannelId" placeholder="Ex: 123456789012345678"
                      class="bg-black/40 border border-white/10 text-white text-sm rounded-xl focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-11 py-3.5 placeholder-slate-600 transition-all shadow-inner" />
                </div>
                <p class="mt-2 text-[11px] text-slate-500 flex items-center gap-1"><i class="fa-solid fa-circle-info"></i> Certifique-se de que o bot possui permissão de escrita.</p>
              </div>

              <input type="hidden" id="logKey" />
            </div>
          </div>
          
          <div class="bg-white/[0.02] px-6 py-5 sm:px-8 sm:flex sm:flex-row-reverse border-t border-white/5 gap-3">
            <button type="button" onclick="saveLogConfig()" class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-lg px-6 py-3 bg-indigo-600 text-base font-semibold text-white hover:bg-indigo-500 hover:shadow-indigo-500/30 sm:w-auto sm:text-sm transition-all focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-[#13151a]">
              Salvar
            </button>
            <button type="button" onclick="closeLogModal()" class="mt-3 w-full inline-flex justify-center rounded-xl border border-white/10 shadow-sm px-6 py-3 bg-transparent text-base font-medium text-slate-300 hover:bg-white/5 hover:text-white sm:mt-0 sm:w-auto sm:text-sm transition-colors">
              Cancelar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Referência -->
    <div class="mt-12 pt-6 border-t border-white/5 relative z-10 flex items-center justify-center opacity-50">
      <p class="text-[10px] text-slate-500 font-mono tracking-widest uppercase flex items-center gap-2">
        <i class="fa-solid fa-fingerprint"></i> <%= info4.guildID %>
      </p>
    </div>

    <script>
      function openLogModal(key, title, channel, state) {
        document.getElementById('modalLogTitle').textContent = title;
        document.getElementById('logKey').value = key;
        document.getElementById('logChannelId').value = channel || '';
        document.getElementById('logState').checked = state;
        document.getElementById('logModal').classList.remove('hidden');
      }

      function closeLogModal() {
        document.getElementById('logModal').classList.add('hidden');
      }

      function saveLogConfig() {
        const key = document.getElementById('logKey').value;
        const channelId = document.getElementById('logChannelId').value;
        const state = document.getElementById('logState').checked;
        const guildId = '<%= info4.guildID %>';

        if (state && !channelId) {
          alert("Para ativar, você deve fornecer um ID de canal válido.");
          return;
        }

        let action = state ? 'actlog_' + key : 'deactlog_' + key;
        const dados = [
          { name: "guildId", value: guildId },
          { name: "func", value: action },
          { name: "channelId", value: channelId || "0" }
        ];

        if (parent && typeof parent.funcsReload === 'function') {
          parent.funcsReload(dados);
          closeLogModal();
        } else {
          console.error("Parent funcsReload not found");
        }
      }
    </script>
    
    <style>
      @keyframes fade-in-up {
          0% { opacity: 0; transform: translateY(20px) scale(0.98); }
          100% { opacity: 1; transform: translateY(0) scale(1); }
      }
      .animate-fade-in-up {
          animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
  </div>
</body>
</html>
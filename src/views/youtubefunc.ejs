<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="../css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <title>Gerenciador de Funções - YouTube</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-10 px-4">

  <div class="bg-[#13151a]/80 backdrop-blur-xl border border-white/10 p-8 md:p-10 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.4)] w-full max-w-full animate-fade-in-up relative overflow-hidden">
    
    <!-- Decorators -->
    <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] bg-red-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div id="mensagemPopUp"
      class="hidden fixed top-5 right-5 z-50 transition-all duration-300 transform translate-y-[-10px] opacity-0"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center gap-6 mb-10 border-b border-white/5 pb-8 relative z-10">
      <div class="relative group mx-auto md:mx-0">
        <div class="absolute -inset-1 bg-gradient-to-r from-red-600 to-orange-500 rounded-2xl blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-300"></div>
        <% if (info.icon && info.icon.indexOf('null')===-1) { %>
          <img src="<%= info.icon %>" alt="Ícone da guilda" class="relative w-20 h-20 rounded-2xl object-cover shadow-lg border border-white/20" />
        <% } else { %>
          <img src="/res/serverIcon/nonserverimg.jpg" alt="Ícone padrão" class="relative w-20 h-20 rounded-2xl object-cover shadow-lg border border-white/20" />
        <% } %>
      </div>
      <div class="flex-1 text-center md:text-left">
        <h3 class="text-3xl font-extrabold text-white mb-2 flex items-center justify-center md:justify-start gap-3 tracking-tight">
          <i class="fa-brands fa-youtube text-red-500"></i>
          Monitoramento YouTube
        </h3>
        <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
          Gerencie os canais inscritos e configure notificações automáticas para novos vídeos em seu servidor.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col sm:flex-row gap-3">
        <% if (info5 && info5.youtubenotify) { %>
          <button onclick="desativarModulo()" class="flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 text-white font-semibold py-3 px-6 rounded-xl border border-white/10 shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
            <i class="fa-solid fa-power-off text-slate-400"></i>
            <span>Desativar Módulo</span>
          </button>
        <% } else { %>
          <button onclick="abrirModal()" class="flex items-center justify-center gap-2 bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white font-semibold py-3 px-6 rounded-xl shadow-[0_0_20px_rgba(239,68,68,0.3)] hover:shadow-[0_0_25px_rgba(239,68,68,0.5)] transition-all duration-200 transform hover:-translate-y-0.5 border border-red-500/50">
            <i class="fa-solid fa-bolt"></i>
            <span>Ativar Módulo</span>
          </button>
        <% } %>
      </div>
    </div>

    <!-- Table Container -->
    <div class="relative z-10 bg-white/[0.02] border border-white/5 rounded-3xl overflow-hidden shadow-inner">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-white/5">
          <thead class="bg-black/20">
            <tr>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">YouTube ID</th>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Nome do Canal</th>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Último Vídeo</th>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Publicação</th>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Mensagem</th>
              <th scope="col" class="px-6 py-5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 bg-transparent">
            <% info2.forEach(item=> { %>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="inline-flex items-center px-2.5 py-1 rounded-md bg-black/40 border border-white/5 text-xs font-mono text-indigo-400 shadow-inner">
                    <%= item.youtube %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-white flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center border border-red-500/20 group-hover:scale-110 transition-transform">
                    <i class="fa-brands fa-youtube text-red-500"></i>
                  </div>
                  <%= item.channel %>
                </td>
                <td class="px-6 py-4 text-sm text-slate-400 truncate max-w-[200px]" title="<%= item.lastVideo %>">
                  <%= item.lastVideo %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-500 font-mono">
                  <%= item.lastPublish %>
                </td>
                <td class="px-6 py-4 text-xs text-slate-500 italic truncate max-w-[150px]" title="<%= item.message %>">
                  "<%= item.message %>"
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-inner">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Ativo <%= item.notifyGuild %>
                  </span>
                </td>
              </tr>
            <% }); %>

            <% if (info2.length===0) { %>
              <tr>
                <td colspan="6" class="px-6 py-16 text-center">
                  <div class="flex flex-col items-center justify-center text-slate-500">
                    <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center border border-white/10 mb-4">
                      <i class="fa-solid fa-inbox text-2xl opacity-50"></i>
                    </div>
                    <p class="text-sm font-medium">Nenhum canal configurado ainda.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Moved Outside to Fix Transform Context -->
  <div id="modal" class="hidden fixed inset-0 z-[9999] overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <!-- Backdrop -->
      <div class="fixed inset-0 bg-[#0b0c10]/80 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="fecharModal()"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <!-- Modal Panel -->
      <div class="inline-block align-bottom bg-[#13151a] rounded-[2rem] border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.8)] text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full z-50 animate-fade-in-up relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 to-orange-500"></div>

        <div class="px-6 pt-8 pb-6 sm:px-8">
          <div class="mb-8">
            <h3 class="text-2xl font-bold text-white mb-4 flex items-center gap-3" id="modal-title">
              <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center border border-red-500/20">
                <i class="fa-brands fa-youtube text-red-500 text-lg"></i>
              </div>
              Ativar Monitoramento
            </h3>
            <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 text-red-200 text-sm flex items-start gap-3">
              <i class="fa-solid fa-circle-info mt-0.5"></i>
              <p>Esta ação ativará o sistema de notificações e definirá o canal de anúncios padrão.</p>
            </div>
          </div>

          <form id="addDataForm" method="post" class="space-y-6">
            <!-- Custom Toggle -->
            <label for="ytb" class="bg-white/5 border border-white/10 rounded-xl p-4 flex items-center justify-between cursor-pointer group hover:bg-white/10 transition-colors">
              <div>
                <h4 class="text-white font-medium text-sm">Confirmar ativação do módulo</h4>
              </div>
              <div class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="ytb" name="ytb" class="sr-only peer" required>
                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500"></div>
              </div>
            </label>

            <!-- Input -->
            <div>
              <label for="channelId" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">ID do Canal de Texto (Discord)</label>
              <div class="relative group/input">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within/input:text-red-500">
                  <i class="fa-solid fa-hashtag text-slate-500 group-focus-within/input:text-red-500 transition-colors"></i>
                </div>
                <input type="text" id="channelId" name="channelId" required
                  placeholder="Ex: 123456789012345678"
                  class="bg-black/40 border border-white/10 text-white text-sm rounded-xl focus:ring-1 focus:ring-red-500 focus:border-red-500 block w-full pl-11 py-3 transition-all shadow-inner font-mono placeholder-slate-600 outline-none" />
              </div>
              <p class="mt-2 text-[11px] text-slate-500">O ID do canal onde os alertas serão enviados.</p>
            </div>

            <input type="hidden" id="guildId" name="guildId" value="<%= info.id %>" />
            <input type="hidden" id="func" name="func" value="actyoutube" />
          </form>
        </div>

        <div class="bg-white/[0.02] px-6 py-5 sm:px-8 sm:flex sm:flex-row-reverse border-t border-white/5 gap-3">
          <button type="button" onclick="envdata()"
            class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-lg px-6 py-3 bg-red-600 text-base font-bold text-white hover:bg-red-500 hover:shadow-red-500/30 sm:w-auto sm:text-sm transition-all transform hover:-translate-y-0.5">
            Confirmar
          </button>
          <button type="button" onclick="fecharModal()"
            class="mt-3 w-full inline-flex justify-center rounded-xl border border-white/10 shadow-sm px-6 py-3 bg-transparent text-base font-medium text-slate-300 hover:bg-white/5 hover:text-white sm:mt-0 sm:w-auto sm:text-sm transition-colors">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <style>
      @keyframes fade-in-up {
          0% { opacity: 0; transform: translateY(20px) scale(0.98); }
          100% { opacity: 1; transform: translateY(0) scale(1); }
      }
      .animate-fade-in-up {
          animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
  </style>

  <script>
    function abrirModal() {
      const modal = document.getElementById("modal");
      modal.classList.remove("hidden");
    }

    function fecharModal() {
      document.getElementById("modal").classList.add("hidden");
    }

    function exibirMensagemErro(mensagem) {
      const popUp = document.getElementById('mensagemPopUp');

      popUp.innerHTML = `
          <div class="flex items-center bg-red-500/90 text-white px-5 py-3.5 rounded-xl shadow-[0_10px_30px_rgba(239,68,68,0.3)] border border-red-400 backdrop-blur-md">
            <i class="fas fa-exclamation-circle mr-3 text-lg"></i>
            <p class="font-bold text-sm tracking-wide">${mensagem}</p>
          </div>
        `;

      popUp.classList.remove('hidden', 'translate-y-[-10px]', 'opacity-0');

      setTimeout(() => {
        popUp.classList.add('translate-y-[-10px]', 'opacity-0');
        setTimeout(() => popUp.classList.add('hidden'), 300);
      }, 4000);
    }

    function desativarModulo() {
      if (!confirm("Tem certeza que deseja desativar o monitoramento do YouTube?")) return;

      const dados = [
        { name: "guildId", value: "<%= info.id %>" },
        { name: "func", value: "deactyoutube" },
        { name: "channelId", value: "0" } // Dummy value
      ];

      if (parent && typeof parent.funcsReload === 'function') {
        parent.funcsReload(dados);
      }
    }

    function envdata() {
      var form = document.getElementById('addDataForm');

      if (!form.checkValidity()) {
        exibirMensagemErro('Por favor, confirme a caixa e preencha todos os campos.');
        return;
      }

      var dadosFormulario = $("#addDataForm").serializeArray();

      fecharModal();
      if (parent && typeof parent.funcsReload === 'function') {
        parent.funcsReload(dadosFormulario);
      } else {
        console.error("Function parent.funcsReload not found");
      }
    }
  </script>
</body>
</html>
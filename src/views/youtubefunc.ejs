<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Gerenciador de Funções - YouTube</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-2 sm:pt-6 px-1 sm:px-2">

  <div class="panel-tone-red p-5 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-full animate-fade-in-up relative overflow-hidden laser-edge-red">
    
    <div id="mensagemPopUp"
      class="hidden fixed top-5 right-5 z-50 transition-all duration-300 transform translate-y-[-10px] opacity-0"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center gap-5 sm:gap-6 mb-8 sm:mb-10 border-b border-red-500/20 pb-6 sm:pb-8 relative z-10">
      <div class="relative mx-auto md:mx-0 flex-shrink-0">
        <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-red-500/30 shadow-lg">
          <% if (info.icon && info.icon.indexOf('null')===-1) { %>
            <img src="<%= info.icon %>" alt="Ícone da guilda" class="w-full h-full object-cover" />
          <% } else { %>
            <img src="/res/serverIcon/nonserverimg.jpg" alt="Ícone padrão" class="w-full h-full object-cover" />
          <% } %>
        </div>
      </div>
      <div class="flex-1 text-center md:text-left min-w-0">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider mb-2">
          <i class="fa-brands fa-youtube text-[11px]"></i>
          <span>Central de Alertas</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight truncate">
          YouTube Hub
        </h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-2xl">
          Configure as notificações de novos vídeos e gerencie os canais inscritos para <strong class="text-white"><%= info.name %></strong>.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col sm:flex-row gap-3">
        <button id="master-toggle-btn" onclick="toggleYoutubeModule()" 
          class="<%= (info5 && info5.youtubenotify) ? 'btn-studio-danger' : 'btn-studio-primary' %> text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2">
          <i class="fa-solid <%= (info5 && info5.youtubenotify) ? 'fa-power-off' : 'fa-bolt' %> text-xs"></i>
          <span id="master-toggle-text"><%= (info5 && info5.youtubenotify) ? 'Desativar Notificações' : 'Ativar Notificações' %></span>
        </button>
      </div>
    </div>

    <!-- Metric Telemetry Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 relative z-10">
      <div class="panel-chassis tonal-border-red p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center border border-red-500/20 text-red-400 flex-shrink-0">
          <i class="fa-solid fa-tower-broadcast text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Serviço de Alertas</span>
          <span id="metric-youtube-status" class="text-sm font-bold <%= (info5 && info5.youtubenotify) ? 'text-emerald-400' : 'text-slate-400' %>">
            <%= (info5 && info5.youtubenotify) ? 'Ativo & Monitorando' : 'Desativado' %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-red p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center border border-red-500/20 text-red-400 flex-shrink-0">
          <i class="fa-solid fa-hashtag text-base"></i>
        </div>
        <div class="min-w-0">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Canal Vinculado</span>
          <span id="metric-youtube-channel" class="text-sm font-bold text-white truncate block font-mono">
            <% 
              let selectedYtbChName = 'Nenhum canal';
              if (info5 && info5.channelytb && typeof channels !== 'undefined' && Array.isArray(channels)) {
                const foundY = channels.find(c => c.id === info5.channelytb);
                if (foundY) selectedYtbChName = '#' + foundY.name;
              }
            %>
            <%= selectedYtbChName %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-red p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center border border-red-500/20 text-red-400 flex-shrink-0">
          <i class="fa-brands fa-youtube text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Canais Ativos</span>
          <span class="text-sm font-bold text-red-400 font-mono"><%= info2.length %> canais</span>
        </div>
      </div>
    </div>

    <!-- Controls Row: Config Card + Quick Add Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8 relative z-10">
      
      <!-- 1. Destination Channel Selector -->
      <div class="lg:col-span-6 panel-elevated tonal-border-red p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-red-950/15 via-[#0f121d] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center border border-red-500/20 text-red-400">
                <i class="fa-solid fa-bullhorn text-xs"></i>
              </div>
              <h4 class="text-white font-bold text-sm">Canal de Destino dos Alertas</h4>
            </div>
            <span id="module-status-pill" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border <%= (info5 && info5.youtubenotify) ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-slate-500/10 text-slate-400 border-slate-500/20' %>">
              <%= (info5 && info5.youtubenotify) ? 'Ativo' : 'Inativo' %>
            </span>
          </div>
          <p class="text-slate-400 text-xs mb-4">O bot enviará mensagens automáticas no canal selecionado quando os criadores publicarem vídeos novos.</p>
          
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-solid fa-hashtag text-xs"></i>
            </div>
            <select id="destinationChannelSelect" class="input-studio !pl-10 !py-2.5 w-full text-sm appearance-none cursor-pointer">
              <option value="0">-- Selecione um Canal de Texto --</option>
              <% if (typeof channels !== 'undefined' && Array.isArray(channels)) { %>
                <% channels.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= (info5 && info5.channelytb === c.id) ? 'selected' : '' %>>
                    # <%= c.name %> <%= c.parentName ? `(${c.parentName})` : '' %>
                  </option>
                <% }); %>
              <% } %>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-500">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-between">
          <button type="button" onclick="testYoutubeAlert()" class="btn-studio-secondary !py-2 !px-3 text-xs font-semibold rounded-xl flex items-center gap-1.5 text-slate-300 hover:text-white" title="Simular disparo de alerta">
            <i class="fa-solid fa-paper-plane text-red-400 text-xs"></i>
            <span>Testar Alerta</span>
          </button>
          <button type="button" onclick="saveDestinationChannel()" class="btn-studio-primary !bg-red-600 hover:!bg-red-500 !py-2 !px-4 text-xs font-semibold rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk text-xs"></i>
            <span>Salvar Canal</span>
          </button>
        </div>
      </div>

      <!-- 2. Quick Add Channel -->
      <div class="lg:col-span-6 panel-elevated tonal-border-red p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-red-950/15 via-[#0f121d] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center gap-2.5 mb-4">
            <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center border border-red-500/20 text-red-400">
              <i class="fa-solid fa-plus text-xs"></i>
            </div>
            <h4 class="text-white font-bold text-sm">Adicionar Canal do YouTube</h4>
          </div>
          <p class="text-slate-400 text-xs mb-4">Digite o nome, ID ou @handle do canal para começar a monitorar suas publicações.</p>
          
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-brands fa-youtube text-xs"></i>
            </div>
            <input type="text" id="newYoutubeChannelInput" placeholder="Ex: MrBeast ou @NomeDoCanal" 
              class="input-studio !pl-10 !py-2.5 w-full text-sm font-medium placeholder:text-slate-600" />
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-end">
          <button type="button" id="btnAddYoutube" onclick="addYoutubeChannel()" class="btn-studio-primary !bg-red-600 hover:!bg-red-500 !py-2 !px-5 text-xs font-semibold rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Cadastrar Canal</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Table Header & Scroll Hint -->
    <div class="flex items-center justify-between mb-3 px-1">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Canais Cadastrados (<span id="channel-count"><%= info2.length %></span>)</span>
      <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 bg-white/[0.04] px-2.5 py-1 rounded-lg border border-white/[0.04] lg:hidden">
        <i class="fa-solid fa-arrows-left-right text-[10px]"></i>
        <span>Deslize a tabela</span>
      </span>
    </div>

    <!-- Table Container (Seamless without stark white border box) -->
    <div class="relative z-10 rounded-2xl overflow-hidden bg-[#090b10]/80">
      <div class="overflow-x-auto w-full custom-table-scroll">
        <table class="w-full min-w-[700px] text-left table-seamless" id="youtubeTable">
          <thead class="bg-black/30 border-b border-white/[0.03]">
            <tr>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Nome do Canal</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">YouTube ID</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Último Vídeo</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Publicação</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.02] bg-transparent" id="youtubeTableBody">
            <% info2.forEach(item=> { %>
              <tr id="row-yt-<%= item.youtube %>" class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-5 py-3.5 whitespace-nowrap text-sm font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center border border-red-500/20 group-hover:scale-110 transition-transform flex-shrink-0 text-red-500">
                      <i class="fa-brands fa-youtube text-sm"></i>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="truncate max-w-[180px]"><%= item.channel %></span>
                      <span class="signal-pill-active text-[9px]">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Monitorando
                      </span>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-black/40 border border-white/5 text-xs font-mono text-indigo-400">
                    <%= item.youtube %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-xs text-slate-400 truncate max-w-[200px]" title="<%= item.lastVideo %>">
                  <%= item.lastVideo || 'Aguardando publicação' %>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap text-xs text-slate-400 font-mono">
                  <%= item.lastPublish ? item.lastPublish.substring(0, 16).replace('T', ' ') : '-' %>
                </td>
                <td class="px-5 py-3.5 whitespace-nowrap text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href="https://www.youtube.com/channel/<%= item.youtube %>" target="_blank" rel="noopener noreferrer" 
                      class="p-2 rounded-xl bg-red-500/5 hover:bg-red-500/15 text-slate-400 hover:text-red-300 transition-colors border border-red-500/20" title="Abrir canal no YouTube">
                      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                    <button type="button" onclick="deleteYoutubeChannel('<%= item.youtube %>', '<%= item.channel %>')"
                      class="btn-studio-danger !py-1.5 !px-3 text-xs font-semibold rounded-xl inline-flex items-center gap-1.5" title="Remover canal">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                      <span>Remover</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>

            <% if (info2.length===0) { %>
              <tr id="empty-youtube-row">
                <td colspan="5" class="px-6 py-16 text-center">
                  <div class="flex flex-col items-center justify-center text-slate-500">
                    <div class="w-14 h-14 rounded-2xl bg-red-500/5 flex items-center justify-center border border-red-500/20 mb-3.5 text-slate-500">
                      <i class="fa-brands fa-youtube text-2xl opacity-50"></i>
                    </div>
                    <p class="text-sm font-semibold text-slate-300">Nenhum canal do YouTube monitorado ainda.</p>
                    <p class="text-xs text-slate-500 mt-1 mb-4 max-w-sm">Cadastre o link ou nome do canal acima para receber avisos imediatos de novos vídeos no Discord.</p>
                    <button type="button" onclick="focusNewYoutubeChannel()" class="btn-studio-secondary !py-2 !px-4 text-xs font-semibold rounded-xl inline-flex items-center gap-2 hover:text-white">
                      <i class="fa-solid fa-plus text-xs text-red-400"></i>
                      <span>Cadastrar Primeiro Canal</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    let isYoutubeActive = <%= (info5 && info5.youtubenotify) ? 'true' : 'false' %>;

    function testYoutubeAlert() {
      const channelSelect = document.getElementById('destinationChannelSelect');
      const channelId = channelSelect ? channelSelect.value : "0";
      const toast = window.showToast || (parent && parent.showToast);
      if (!channelId || channelId === "0") {
        if (toast) toast('warning', 'Canal Não Configurado', 'Selecione e salve um canal de texto para testar o envio de alertas.');
        else alert('Selecione um canal de texto primeiro.');
        return;
      }
      const opt = channelSelect.querySelector(`option[value="${channelId}"]`);
      const chanName = opt ? opt.text.trim().split(' ')[0] : channelId;
      if (toast) {
        toast('info', 'Simulação de Notificação', `Alerta de teste enviado para ${chanName}! Rota e permissões validadas.`);
      }
    }

    async function toggleYoutubeModule() {
      const btn = document.getElementById('master-toggle-btn');
      const text = document.getElementById('master-toggle-text');
      const pill = document.getElementById('module-status-pill');
      const channelSelect = document.getElementById('destinationChannelSelect');
      const channelId = channelSelect ? channelSelect.value : "0";

      const action = isYoutubeActive ? 'deactyoutube' : 'actyoutube';
      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);

      if (typeof executeAction === 'function') {
        const res = await executeAction(action, channelId || "0");
        if (res && res.success) {
          isYoutubeActive = !isYoutubeActive;
          if (isYoutubeActive) {
            btn.className = 'btn-studio-danger text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
            btn.querySelector('i').className = 'fa-solid fa-power-off text-xs';
            text.textContent = 'Desativar Notificações';
            if (pill) {
              pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
              pill.textContent = 'Ativo';
            }
            const metricStatus = document.getElementById('metric-youtube-status');
            if (metricStatus) {
              metricStatus.className = 'text-sm font-bold text-emerald-400';
              metricStatus.textContent = 'Ativo & Monitorando';
            }
          } else {
            btn.className = 'btn-studio-primary text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
            btn.querySelector('i').className = 'fa-solid fa-bolt text-xs';
            text.textContent = 'Ativar Notificações';
            if (pill) {
              pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-slate-500/10 text-slate-400 border-slate-500/20';
              pill.textContent = 'Inativo';
            }
            const metricStatus = document.getElementById('metric-youtube-status');
            if (metricStatus) {
              metricStatus.className = 'text-sm font-bold text-slate-400';
              metricStatus.textContent = 'Desativado';
            }
          }
        }
      }
    }

    async function saveDestinationChannel() {
      const select = document.getElementById('destinationChannelSelect');
      const channelId = select ? select.value : "0";

      if (!channelId || channelId === "0") {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Canal Inválido', 'Por favor, selecione um canal de texto do Discord.');
        return;
      }

      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);
      if (typeof executeAction === 'function') {
        const res = await executeAction('updtyoutube', channelId);
        if (res && res.success) {
          const opt = select.querySelector(`option[value="${channelId}"]`);
          const chanName = opt ? opt.text.trim().split(' ')[0] : channelId;
          const metricChan = document.getElementById('metric-youtube-channel');
          if (metricChan) metricChan.textContent = chanName;
        }
      }
    }

    async function addYoutubeChannel() {
      const input = document.getElementById('newYoutubeChannelInput');
      const channelInput = (input ? input.value : '').trim();
      const btn = document.getElementById('btnAddYoutube');

      if (!channelInput) {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Campo Vazio', 'Digite o nome ou ID do canal do YouTube.');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin text-xs"></i> <span>Adicionando...</span>';
      }

      const executeDb = window.executeDbAction || (parent && parent.executeDbAction);
      if (typeof executeDb === 'function') {
        const res = await executeDb('addyoutubech', channelInput);
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-plus text-xs"></i> <span>Cadastrar Canal</span>';
        }

        if (res && res.success) {
          if (input) input.value = '';
          if (parent && typeof parent.carregarConteudo === 'function') {
            parent.carregarConteudo('funcyoutube', false);
          }
        }
      }
    }

    async function deleteYoutubeChannel(youtubeId, channelName) {
      if (!confirm(`Deseja remover o canal "${channelName || youtubeId}" do monitoramento?`)) return;

      const executeDb = window.executeDbAction || (parent && parent.executeDbAction);
      if (typeof executeDb === 'function') {
        const res = await executeDb('delyoutubech', youtubeId);
        if (res && res.success) {
          const row = document.getElementById(`row-yt-${youtubeId}`);
          if (row) {
            row.style.transition = 'all 0.3s ease';
            row.style.opacity = '0';
            row.style.transform = 'scale(0.95)';
            setTimeout(() => {
              row.remove();
              const countElem = document.getElementById('channel-count');
              if (countElem) {
                const count = Math.max(0, parseInt(countElem.textContent || '1') - 1);
                countElem.textContent = count;
              }
            }, 300);
          }
        }
      }
    }

    function focusNewYoutubeChannel() {
      const input = document.getElementById('newYoutubeChannelInput');
      if (input) {
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          input.focus();
        }, 300);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('newYoutubeChannelInput');
      if (input) {
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            addYoutubeChannel();
          }
        });
      }
    });
  </script>
</body>
</html>
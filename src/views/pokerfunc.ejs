<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Gerenciador de Funções - Texas Hold'em</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-2 sm:pt-6 px-1 sm:px-2">
<%
  const server = (typeof botInfo !== 'undefined' && botInfo) ? botInfo : (info && info.name ? info : {});
  const pokerData = (typeof info5 !== 'undefined' && info5 && info5.poker) ? info5.poker : (typeof guildinfo !== 'undefined' && guildinfo && guildinfo.poker ? guildinfo.poker : (info && info.poker ? info.poker : {}));
  const isPokerStateActive = Boolean(pokerData && pokerData.state);
  const selectedPokerChannel = (pokerData && pokerData.channel) ? pokerData.channel : '';
  const currentGuildId = server.id || (info && (info.id || info.guildID)) || '';
  const currentGuildName = server.name || (info && info.name) || 'Servidor';
  const currentGuildIcon = (server && server.icon && server.icon.indexOf('null') === -1) ? server.icon : ((info && info.icon && info.icon.indexOf('null') === -1) ? info.icon : null);
%>

  <div class="panel-tone-amber p-5 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-full animate-fade-in-up relative overflow-hidden laser-edge-amber">
    
    <div id="mensagemPopUp"
      class="hidden fixed top-5 right-5 z-50 transition-all duration-300 transform translate-y-[-10px] opacity-0"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center gap-5 sm:gap-6 mb-8 sm:mb-10 border-b border-amber-500/20 pb-6 sm:pb-8 relative z-10">
      <div class="relative mx-auto md:mx-0 flex-shrink-0">
        <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-amber-500/30 shadow-lg">
          <% if (currentGuildIcon) { %>
            <img src="<%= currentGuildIcon %>" alt="Ícone da guilda" class="w-full h-full object-cover" />
          <% } else { %>
            <img src="/res/serverIcon/nonserverimg.jpg" alt="Ícone padrão" class="w-full h-full object-cover" />
          <% } %>
        </div>
      </div>
      <div class="flex-1 text-center md:text-left min-w-0">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-2">
          <i class="fa-solid fa-diamond text-[11px]"></i>
          <span>Casino & Jogos</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight truncate">
          Texas Hold'em Hub
        </h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-2xl">
          Centralize as partidas de poker. Defina um canal exclusivo para as mesas e gerencie os parâmetros de jogo para <strong class="text-white"><%= currentGuildName %></strong>.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col sm:flex-row gap-3">
        <button id="master-toggle-btn" onclick="togglePokerModule()" 
          class="<%= isPokerStateActive ? 'btn-studio-danger' : 'btn-studio-primary !bg-amber-600 hover:!bg-amber-500' %> text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2">
          <i class="fa-solid <%= isPokerStateActive ? 'fa-power-off' : 'fa-bolt' %> text-xs"></i>
          <span id="master-toggle-text"><%= isPokerStateActive ? 'Desativar Mesa' : 'Ativar Mesa' %></span>
        </button>
      </div>
    </div>

    <!-- Metric Telemetry Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 relative z-10">
      <div class="panel-chassis tonal-border-amber p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400 flex-shrink-0">
          <i class="fa-solid fa-gamepad text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estado da Mesa</span>
          <span id="metric-poker-status" class="text-sm font-bold <%= isPokerStateActive ? 'text-emerald-400' : 'text-slate-400' %>">
            <%= isPokerStateActive ? 'Ativo & Pronto' : 'Desativado' %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-amber p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400 flex-shrink-0">
          <i class="fa-solid fa-hashtag text-base"></i>
        </div>
        <div class="min-w-0">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Canal Vinculado</span>
          <span id="metric-poker-channel" class="text-sm font-bold text-white truncate block font-mono">
            <% 
              let selectedChName = 'Nenhum canal';
              if (selectedPokerChannel && typeof info4 !== 'undefined' && Array.isArray(info4)) {
                const found = info4.find(c => c.id === selectedPokerChannel);
                if (found) selectedChName = '#' + found.name;
              }
            %>
            <%= selectedChName %>
          </span>
        </div>
      </div>

      <div class="panel-chassis tonal-border-amber p-4 rounded-xl flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400 flex-shrink-0">
          <i class="fa-solid fa-coins text-base"></i>
        </div>
        <div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Modalidade</span>
          <span class="text-sm font-bold text-amber-400">No-Limit Hold'em</span>
        </div>
      </div>
    </div>

    <!-- Controls Row: Config Card + Quick Rules Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8 relative z-10">
      
      <!-- 1. Destination Channel Selector -->
      <div class="lg:col-span-6 panel-elevated tonal-border-amber p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-amber-950/15 via-[#121017] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400">
                <i class="fa-solid fa-bullhorn text-xs"></i>
              </div>
              <h4 class="text-white font-bold text-sm">Canal Exclusivo da Mesa</h4>
            </div>
            <span id="module-status-pill" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border <%= isPokerStateActive ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-slate-500/10 text-slate-400 border-slate-500/20' %>">
              <%= isPokerStateActive ? 'Ativo' : 'Inativo' %>
            </span>
          </div>
          <p class="text-slate-400 text-xs mb-4">Selecione onde as rodadas de poker devem rodar. Recomendamos um canal exclusivo como <span class="text-amber-400 font-mono">#cassino</span> ou <span class="text-amber-400 font-mono">#poker</span>.</p>
          
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-solid fa-hashtag text-xs"></i>
            </div>
            <select id="destinationChannelSelect" class="input-studio !pl-10 !py-2.5 w-full text-sm appearance-none cursor-pointer">
              <option value="0">-- Selecione um Canal de Texto --</option>
              <% if (typeof info4 !== 'undefined' && Array.isArray(info4)) { %>
                <% info4.forEach(function(c) { %>
                  <% if (c.type !== 2 && c.type !== 4) { %>
                    <option value="<%= c.id %>" <%= (selectedPokerChannel === c.id) ? 'selected' : '' %>>
                      # <%= c.name %>
                    </option>
                  <% } %>
                <% }); %>
              <% } %>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-500">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-between">
          <button type="button" onclick="testPokerNotification()" class="btn-studio-secondary !py-2 !px-3 text-xs font-semibold rounded-xl flex items-center gap-1.5 text-slate-300 hover:text-white" title="Verificar status da configuração">
            <i class="fa-solid fa-circle-check text-amber-400 text-xs"></i>
            <span>Verificar Canal</span>
          </button>
          <button type="button" onclick="saveDestinationChannel()" class="btn-studio-primary !bg-amber-600 hover:!bg-amber-500 !py-2 !px-4 text-xs font-semibold rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk text-xs"></i>
            <span>Salvar Canal</span>
          </button>
        </div>
      </div>

      <!-- 2. Quick Command & Rules Card -->
      <div class="lg:col-span-6 panel-elevated tonal-border-amber p-5 sm:p-6 rounded-2xl flex flex-col justify-between bg-gradient-to-b from-amber-950/15 via-[#121017] to-[#0a0c13] relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400">
                <i class="fa-solid fa-terminal text-xs"></i>
              </div>
              <h4 class="text-white font-bold text-sm">Comando no Discord</h4>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20">Slash Command</span>
          </div>
          <p class="text-slate-400 text-xs mb-4">Os membros do servidor iniciam a mesa diretamente no chat usando a interface nativa de botões do Discord.</p>
          
          <div class="bg-black/40 rounded-xl p-3 border border-white/[0.04] flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <kbd class="kbd-studio text-xs text-white">/poker</kbd>
              <span class="text-xs text-slate-400 font-mono">Abre nova rodada de apostas</span>
            </div>
            <button type="button" onclick="copyPokerCmd(this)" class="btn-studio-secondary !py-1 !px-2.5 text-xs font-mono text-amber-300 hover:text-white flex items-center gap-1.5" title="Copiar comando">
              <i class="fa-regular fa-copy text-[11px]"></i>
              <span>Copiar</span>
            </button>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-white/[0.04] flex items-center justify-between">
          <span class="text-xs text-slate-400 flex items-center gap-1.5">
            <i class="fa-solid fa-coins text-amber-400 text-xs"></i>
            Integrado ao sistema de moedas
          </span>
          <a href="javascript:void(0)" onclick="if(parent && parent.selectTopic) parent.selectTopic('economyinfo');" class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1">
            <span>Ver Economia</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      </div>

    </div>

    <!-- Table Header & Details -->
    <div class="flex items-center justify-between mb-3 px-1">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Ações & Regras da Mesa</span>
      <span class="text-xs text-slate-500 font-mono">Regras Texas Hold'em</span>
    </div>

    <!-- Table Container (Seamless without stark white border box) -->
    <div class="relative z-10 rounded-2xl overflow-hidden bg-[#090b10]/80">
      <div class="overflow-x-auto w-full custom-table-scroll">
        <table class="w-full min-w-[650px] text-left table-seamless">
          <thead class="bg-black/30 border-b border-white/[0.03]">
            <tr>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Ação no Jogo</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Gatilho / Interface</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Descrição</th>
              <th scope="col" class="px-5 py-3.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">Permissão</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.02] bg-transparent">
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-5 py-3.5 whitespace-nowrap text-sm font-bold text-white">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400">
                    <i class="fa-solid fa-play text-xs"></i>
                  </div>
                  <span>Iniciar Nova Mesa</span>
                </div>
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <kbd class="kbd-studio text-[11px] text-white">/poker</kbd>
              </td>
              <td class="px-5 py-3.5 text-xs text-slate-400">
                Abre uma mesa no canal configurado aguardando jogadores entrarem na rodada.
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-right">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Todos</span>
              </td>
            </tr>

            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-5 py-3.5 whitespace-nowrap text-sm font-bold text-white">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                  </div>
                  <span>Entrar na Rodada</span>
                </div>
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <span class="px-2.5 py-1 rounded-md bg-black/40 border border-white/5 text-xs font-mono text-slate-300">Botão "Entrar"</span>
              </td>
              <td class="px-5 py-3.5 text-xs text-slate-400">
                Ocupa um assento na mesa e realiza o buy-in inicial utilizando moedas do servidor.
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-right">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Todos</span>
              </td>
            </tr>

            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-5 py-3.5 whitespace-nowrap text-sm font-bold text-white">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 text-amber-400">
                    <i class="fa-solid fa-sliders text-xs"></i>
                  </div>
                  <span>Apostar / Pagar / Correr</span>
                </div>
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <span class="px-2.5 py-1 rounded-md bg-black/40 border border-white/5 text-xs font-mono text-slate-300">Check / Call / Raise / Fold</span>
              </td>
              <td class="px-5 py-3.5 text-xs text-slate-400">
                Controles efetuados via botões e modais no Discord em cada etapa (Flop, Turn, River).
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-right">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">Participantes</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    let isPokerActive = <%= isPokerStateActive ? 'true' : 'false' %>;

    async function togglePokerModule() {
      const select = document.getElementById('destinationChannelSelect');
      const channelId = select ? select.value : "0";
      const btn = document.getElementById('master-toggle-btn');
      const text = document.getElementById('master-toggle-text');
      const pill = document.getElementById('module-status-pill');
      const metricStatus = document.getElementById('metric-poker-status');

      const action = isPokerActive ? 'deactpoker' : 'actpoker';

      if (!isPokerActive && (!channelId || channelId === "0")) {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Selecione um Canal', 'Por favor, selecione um canal de texto antes de ativar a mesa.');
        if (select) select.focus();
        return;
      }

      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);

      if (typeof executeAction === 'function') {
        const res = await executeAction(action, channelId || "0");
        if (res && res.success) {
          isPokerActive = !isPokerActive;
          updatePokerUI(isPokerActive);
        }
      } else {
        // Direct AJAX fallback
        try {
          const guildId = "<%= currentGuildId %>";
          const res = await fetch(`/bot/pagina/funcs/${action}/${guildId}/${encodeURIComponent(channelId || '0')}`, {
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
          });
          const data = await res.json();
          if (data.success) {
            isPokerActive = !isPokerActive;
            updatePokerUI(isPokerActive);
            const toast = window.showToast || (parent && parent.showToast);
            if (toast) toast('success', 'Mesa Atualizada', data.message || 'Configuração salva!');
          }
        } catch (e) {
          console.error(e);
        }
      }
    }

    function updatePokerUI(active) {
      const btn = document.getElementById('master-toggle-btn');
      const text = document.getElementById('master-toggle-text');
      const pill = document.getElementById('module-status-pill');
      const metricStatus = document.getElementById('metric-poker-status');

      if (btn && text) {
        if (active) {
          btn.className = 'btn-studio-danger text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
          btn.querySelector('i').className = 'fa-solid fa-power-off text-xs';
          text.textContent = 'Desativar Mesa';
        } else {
          btn.className = 'btn-studio-primary !bg-amber-600 hover:!bg-amber-500 text-xs sm:text-sm font-semibold !py-2.5 !px-5 rounded-xl flex items-center justify-center gap-2';
          btn.querySelector('i').className = 'fa-solid fa-bolt text-xs';
          text.textContent = 'Ativar Mesa';
        }
      }

      if (pill) {
        if (active) {
          pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
          pill.textContent = 'Ativo';
        } else {
          pill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase border bg-slate-500/10 text-slate-400 border-slate-500/20';
          pill.textContent = 'Inativo';
        }
      }

      if (metricStatus) {
        if (active) {
          metricStatus.className = 'text-sm font-bold text-emerald-400';
          metricStatus.textContent = 'Ativo & Pronto';
        } else {
          metricStatus.className = 'text-sm font-bold text-slate-400';
          metricStatus.textContent = 'Desativado';
        }
      }
    }

    async function saveDestinationChannel() {
      const select = document.getElementById('destinationChannelSelect');
      const channelId = select ? select.value : "0";

      if (!channelId || channelId === "0") {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('warning', 'Canal Inválido', 'Por favor, selecione um canal de texto do Discord.');
        return;
      }

      const executeAction = window.executeFuncAction || (parent && parent.executeFuncAction);
      if (typeof executeAction === 'function') {
        const res = await executeAction('actpoker', channelId);
        if (res && res.success) {
          isPokerActive = true;
          updatePokerUI(true);

          const metricChannel = document.getElementById('metric-poker-channel');
          if (metricChannel && select.selectedOptions && select.selectedOptions[0]) {
            metricChannel.textContent = select.selectedOptions[0].text.trim();
          }
        }
      }
    }

    function testPokerNotification() {
      const select = document.getElementById('destinationChannelSelect');
      const channelId = select ? select.value : "0";
      const toast = window.showToast || (parent && parent.showToast);

      if (!channelId || channelId === "0") {
        if (toast) toast('warning', 'Canal Não Configurado', 'Selecione e salve um canal para a mesa de poker.');
      } else {
        const name = select.selectedOptions[0] ? select.selectedOptions[0].text.trim() : `#${channelId}`;
        if (toast) toast('info', 'Verificação Concluída', `O canal ${name} está pronto para receber mesas de Texas Hold'em.`);
      }
    }

    function copyPokerCmd(btn) {
      navigator.clipboard.writeText('/poker').then(() => {
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-check text-[11px] text-emerald-400"></i> <span class="text-emerald-400">Copiado!</span>';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      }).catch(() => {
        const toast = window.showToast || (parent && parent.showToast);
        if (toast) toast('info', 'Comando', 'Use /poker no chat do Discord.');
      });
    }
  </script>
</body>

</html>
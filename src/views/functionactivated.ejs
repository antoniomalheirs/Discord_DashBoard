<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Configuração Atualizada</title>
</head>

<body class="bg-transparent min-h-full">

  <div class="min-h-[70vh] flex items-center justify-center w-full py-4 px-2">
    <!-- Main Card -->
    <div class="panel-elevated p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-md animate-fade-in-up relative overflow-hidden mx-auto">

    <!-- Success Icon -->
    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mb-5 shadow-lg">
      <i class="fa-solid fa-check text-2xl"></i>
    </div>

    <!-- Title -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Sucesso</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Módulo Atualizado</h3>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">
        A configuração do recurso <strong class="text-white"><%=nome%></strong> foi salva com sucesso.
      </p>
    </div>

    <!-- Details -->
    <div class="panel-elevated p-4 sm:p-5 rounded-2xl space-y-3 mb-6 text-xs">

      <div class="flex items-center justify-between py-1.5 border-b border-white/[0.04]">
        <span class="font-medium text-slate-400">Status</span>
        <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold uppercase tracking-wider text-[11px]">
          <%=info%>
        </span>
      </div>

      <div class="flex items-center justify-between py-1.5 border-b border-white/[0.04]">
        <span class="font-medium text-slate-400">Servidor</span>
        <span class="font-semibold text-white truncate max-w-[180px]">
          <%=info2%>
        </span>
      </div>

      <div class="flex items-center justify-between py-1.5">
        <span class="font-medium text-slate-400">Canal Vinculado</span>
        <div class="flex items-center gap-1.5 text-indigo-300 font-mono text-[11px] bg-black/30 py-1 px-2.5 rounded-lg border border-white/[0.06]">
          <i class="fa-solid fa-hashtag text-slate-500 text-[10px]"></i>
          <span><%=info3%></span>
        </div>
      </div>

    </div>

    <!-- Return Button -->
    <div class="flex justify-center mb-6">
      <button onclick="voltarAoPainel()"
        class="btn-studio-primary !py-2.5 !px-8 text-xs sm:text-sm font-semibold rounded-xl flex items-center gap-2">
        <i class="fa-solid fa-arrow-left text-xs"></i>
        <span>Voltar ao Painel</span>
      </button>
    </div>

    <!-- Footer Decor -->
    <div class="text-center">
      <p class="text-[10px] text-slate-500 font-medium tracking-widest uppercase">Discord Bot Manager • Sistema</p>
    </div>
  </div>
  </div>

  <script>
    function voltarAoPainel() {
      <% if (typeof backUrl !== 'undefined' && backUrl) { %>
        if (parent && parent.loadPanelUrl) {
          parent.loadPanelUrl('<%= backUrl %>', true);
        } else {
          window.location.href = '<%= backUrl %>';
        }
      <% } else { %>
        if (window.history.length > 1) {
          window.history.back();
        } else if (parent && parent.selectTopic) {
          parent.selectTopic('server');
        }
      <% } %>
    }
  </script>

  <style>
    @keyframes fade-in-up {
      0% { opacity: 0; transform: translateY(20px) scale(0.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

</body>

</html>
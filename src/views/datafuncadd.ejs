<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/css/cssdir/out.css" rel="stylesheet" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
  <title>Canal Adicionado | Discord Bot</title>
</head>

<body class="bg-transparent min-h-full">
  <div class="min-h-[70vh] flex items-center justify-center w-full py-4 px-2">
    <div class="panel-elevated p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xl w-full max-w-md animate-fade-in-up relative overflow-hidden mx-auto">

      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 mb-5 shadow-lg">
        <i class="fa-solid fa-cloud-arrow-up text-2xl"></i>
      </div>

      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Registrado</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Canal Adicionado!</h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Notificações configuradas para <span class="font-bold text-white"><%=nome%></span>.
        </p>
      </div>

      <div class="panel-elevated p-4 sm:p-5 rounded-2xl space-y-3 mb-6 text-xs">
        <div class="flex items-center justify-between py-1.5 border-b border-white/[0.04]">
          <span class="font-medium text-slate-400">Canal / Criador</span>
          <span class="font-semibold text-white truncate max-w-[180px]">
            <%=info%>
          </span>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-white/[0.04]">
          <span class="font-medium text-slate-400">ID do Canal</span>
          <span class="font-mono text-indigo-300 text-[11px] truncate max-w-[180px]">
            <%=info2%>
          </span>
        </div>
        <div class="flex items-center justify-between py-1.5">
          <span class="font-medium text-slate-400">Servidor</span>
          <span class="font-semibold text-white truncate max-w-[180px]">
            <%=info1%>
          </span>
        </div>
      </div>

      <div class="flex justify-center">
        <button onclick="voltarAoDashboard()"
          class="btn-studio-primary !py-2.5 !px-8 text-xs sm:text-sm font-semibold rounded-xl flex items-center gap-2">
          <i class="fa-solid fa-arrow-left text-xs"></i>
          <span>Voltar ao Painel</span>
        </button>
      </div>

    </div>
  </div>

  <style>
    @keyframes fade-in-up {
      0% { opacity: 0; transform: translateY(20px) scale(0.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

  <script>
    function voltarAoDashboard() {
      if (window.parent && window.parent !== window && window.parent.selectTopic) {
        window.parent.selectTopic('server');
      } else if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/dashboard';
      }
    }
  </script>
</body>

</html>
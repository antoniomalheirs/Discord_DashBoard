<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../css/cssdir/out.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>Selecionar Servidor - Dashboard</title>
  </head>
  <body class="bg-[#0f1115] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-indigo-500 selection:text-white antialiased overflow-x-hidden">
    
    <!-- Background Decorators -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-[#0f1115] to-[#0f1115]"></div>
        <div class="absolute top-[10%] left-[5%] w-[40%] h-[40%] rounded-full bg-indigo-600/10 blur-[120px]"></div>
        <div class="absolute bottom-[10%] right-[5%] w-[40%] h-[40%] rounded-full bg-purple-600/10 blur-[120px]"></div>
    </div>

    <!-- Navigation (Simpler for Dashboard) -->
    <header class="relative z-50 bg-[#0f1115]/50 backdrop-blur-md border-b border-white/5">
        <nav class="container mx-auto flex items-center justify-between p-4 lg:px-8">
            <div class="flex items-center gap-3">
                <a href="/" class="relative group">
                    <div class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl blur opacity-30 group-hover:opacity-70 transition duration-500"></div>
                    <img class="relative h-10 w-10 rounded-xl object-cover" src="/res/serverIcon/boticon.jpg" alt="Bot Icon">
                </a>
                <span class="font-bold tracking-tight text-white/90">Painel de Controle</span>
            </div>
            
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3 bg-white/5 px-4 py-1.5 rounded-full border border-white/10">
                    <img class="h-8 w-8 rounded-full border border-white/20" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="User Avatar">
                    <span class="text-sm font-medium text-slate-200"><%= user.username %></span>
                </div>
            </div>
        </nav>
    </header>

    <!-- Content Container -->
    <main class="relative z-10 w-full max-w-7xl mx-auto flex-grow flex flex-col pt-16 px-4 sm:px-6 lg:px-8 pb-20">
        
        <!-- Header -->
        <div class="text-center mb-16 animate-fade-in-up">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400 mb-4">
                Selecione um Servidor
            </h1>
            <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
                Escolha um servidor abaixo para gerenciar as configurações, plugins e estatísticas.
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% user.guilds.forEach((guild, index) => { %>
                <div class="group bg-white/[0.02] backdrop-blur-md rounded-2xl border border-white/[0.05] shadow-xl hover:shadow-[0_0_30px_rgba(99,102,241,0.15)] hover:bg-white/[0.04] hover:border-indigo-500/30 transition-all duration-300 flex flex-col overflow-hidden relative animate-fade-in-up" style="animation-delay: <%= index * 50 %>ms;">
                    
                    <div class="p-6 flex flex-col items-center flex-grow relative z-10">
                        <!-- Icon -->
                        <div class="relative mb-6">
                            <div class="absolute inset-0 bg-indigo-500 rounded-full blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-300"></div>
                            <img 
                                class="relative h-24 w-24 rounded-full object-cover border-2 border-white/10 shadow-md group-hover:border-indigo-500/50 transition-colors duration-300" 
                                src="/res/serverIcon/nonserverimg.jpg" 
                                id="AguildIcon<%= guild.id %>"
                                alt="<%= guild.name %> icon"
                            />
                        </div>

                        <!-- Info -->
                        <h3 class="text-xl font-bold text-white mb-2 text-center truncate w-full px-2" title="<%= guild.name %>">
                            <%= guild.name %>
                        </h3>
                        <div class="flex items-center gap-2 mb-8">
                            <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono text-slate-400">
                                ID: <%= guild.id %>
                            </span>
                        </div>

                        <!-- Action -->
                        <form action="/bot/botinfo" method="post" class="w-full mt-auto">
                            <input type="hidden" id="guilds" name="guilds" value="<%= guild.id %>"/>
                            <input type="hidden" id="nameofGuild" name="nameofGuild" value="<%= guild.name %>"/>
                            <input type="hidden" id="icon" name="icon" value="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"/>
                            
                            <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600/80 hover:bg-indigo-500 text-white font-medium rounded-xl border border-indigo-500/50 shadow-lg hover:shadow-indigo-500/30 transition-all duration-200 flex items-center justify-center gap-2">
                                <span>Configurar Bot</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <style>
        @keyframes fade-in-up {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }
    </style>

    <script>
      async function redirecionarParaRota(guildId) {
          try {
              const response = await fetch(`/bot/obter-icone-guilda/${guildId}`);
              if (!response.ok) return;
              const data = await response.json();
              const guildIcon = document.getElementById("AguildIcon" + guildId);
              if (guildIcon && data.iconURL) {
                  guildIcon.src = data.iconURL;
              }
          } catch (error) {
              console.error("Erro ao carregar imagem da guilda:", error);
          }
      }

      window.onload = function() {
          const guilds = JSON.parse('<%- JSON.stringify(user.guilds).replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>');
          guilds.forEach(guild => {
              redirecionarParaRota(guild.id);
          });
      }
    </script>
  </body>
</html>

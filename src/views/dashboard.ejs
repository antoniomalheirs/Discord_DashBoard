<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/cssdir/out.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
    <title>Selecionar Servidor - Dashboard</title>
  </head>
  <body class="bg-[#090b10] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-indigo-500 selection:text-white antialiased overflow-x-hidden">
    
    <!-- Background Decorators -->
    <div class="fixed inset-0 z-0 pointer-events-none bg-[#090a0f] bg-blueprint"></div>
    <div class="fixed inset-0 z-0 pointer-events-none opacity-50">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-[radial-gradient(ellipse_at_top,_rgba(88,101,242,0.10),_transparent_70%)]"></div>
    </div>

    <!-- Navigation (unified with home.ejs) -->
    <header class="relative z-50 bg-[#090a0f]/80 backdrop-blur-xl border-b border-white/[0.08] transition-all duration-300">
        <nav class="container mx-auto flex items-center justify-between p-4 lg:px-8">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-3 group">
                    <div class="relative w-9 h-9 rounded-xl overflow-hidden border border-white/10 shadow-sm group-hover:border-indigo-500/50 transition-colors">
                        <img class="w-full h-full object-cover" src="/res/serverIcon/boticon.jpg" alt="Bot Icon">
                    </div>
                    <span class="font-bold text-base sm:text-lg tracking-tight text-white group-hover:text-slate-200 transition-colors">Manager Bot</span>
                </a>
            </div>
            
            <!-- Desktop Nav Links -->
            <div class="hidden lg:flex items-center lg:gap-x-1 bg-white/[0.03] border border-white/[0.08] px-3 py-1.5 rounded-full">
                <a href="/auth/docs" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Documentação</a>
                <a href="/auth/funcutils" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Módulos</a>
                <a href="/auth/about" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Arquitetura</a>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2.5 bg-indigo-500/10 px-3.5 py-1.5 rounded-full border border-indigo-500/20 shadow-sm">
                    <img class="h-7 w-7 rounded-full object-cover border border-indigo-500/30" src="<%= (user && user.avatar) ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="User Avatar">
                    <span class="text-xs sm:text-sm font-medium text-slate-200"><%= user.username %></span>
                </div>
                <a href="/auth/logout" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-red-400 hover:bg-red-500/10 border border-transparent hover:border-red-500/20 transition-all" title="Desconectar">
                    <i class="fa-solid fa-power-off text-[10px]"></i>
                    <span>Sair</span>
                </a>
            </div>
        </nav>
    </header>

    <!-- Content Container -->
    <main class="relative z-10 w-full max-w-7xl mx-auto flex-grow flex flex-col pt-10 sm:pt-14 px-4 sm:px-6 lg:px-8 pb-12">
        
        <%
          const guilds = (user && Array.isArray(user.guilds)) ? user.guilds : [];
          let countOwner = 0;
          let countAdmin = 0;
          if (guilds.length > 0) {
            guilds.forEach(g => {
              if (g.owner) countOwner++;
              else {
                let isAdm = false;
                try {
                  const p = BigInt(g.permissions || 0);
                  isAdm = (p & 0x8n) === 0x8n;
                } catch(e) {
                  isAdm = (Number(g.permissions || 0) & 0x8) === 0x8;
                }
                if (isAdm) countAdmin++;
              }
            });
          }
          const countGerente = guilds.length - countOwner - countAdmin;
        %>

        <!-- Header Contextual -->
        <div class="mb-8 sm:mb-10 dashboard-header-enter">
            <!-- User Context Row -->
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 mb-6 sm:mb-8">
                <div class="relative flex-shrink-0">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden border border-indigo-500/25 shadow-lg bg-black/40">
                        <img class="w-full h-full object-cover" src="<%= (user && user.avatar) ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar">
                    </div>
                    <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-[3px] border-[#090b10] flex items-center justify-center">
                        <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
                    </div>
                </div>
                <div class="text-center sm:text-left flex-1 min-w-0">
                    <% 
                      const hour = new Date().getHours();
                      const greeting = hour < 12 ? 'Bom dia' : hour < 18 ? 'Boa tarde' : 'Boa noite';
                    %>
                    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-1">
                        <%= greeting %>, <span class="text-indigo-300"><%= user.username %></span>
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                        Selecione um servidor para acessar logs, estatísticas e módulos automatizados.
                    </p>

                    <!-- Inline Metrics -->
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1 mt-3">
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-slate-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                            <span><strong class="text-white font-semibold"><%= guilds.length %></strong> <%= guilds.length === 1 ? 'servidor' : 'servidores' %></span>
                        </span>
                        <% if (countOwner > 0) { %>
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-slate-400">
                            <i class="fa-solid fa-crown text-amber-400 text-[9px]"></i>
                            <span><strong class="text-amber-400 font-semibold"><%= countOwner %></strong> como dono</span>
                        </span>
                        <% } %>
                        <% if (countAdmin > 0) { %>
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-slate-400">
                            <i class="fa-solid fa-shield-halved text-indigo-400 text-[9px]"></i>
                            <span><strong class="text-indigo-300 font-semibold"><%= countAdmin %></strong> como admin</span>
                        </span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Search & Filters -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
                <div class="relative flex-1 max-w-lg">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                    <input 
                        type="text" 
                        id="guild-search-input" 
                        oninput="filterGuilds(this.value)" 
                        placeholder="Buscar servidor por nome ou ID..." 
                        class="input-studio !pl-11 !pr-10 !py-2.5 w-full text-sm placeholder:text-slate-500"
                    />
                    <kbd class="hidden sm:inline-flex absolute right-3.5 top-1/2 -translate-y-1/2 kbd-studio pointer-events-none">/</kbd>
                </div>

                <div class="hardware-segmented-control flex-shrink-0 self-center sm:self-auto" id="roleFilterControl">
                    <button type="button" onclick="setGuildRoleFilter('all', this)" class="hardware-segmented-item active">
                      <span>Todos (<%= guilds.length %>)</span>
                    </button>
                    <button type="button" onclick="setGuildRoleFilter('owner', this)" class="hardware-segmented-item">
                      <i class="fa-solid fa-crown text-amber-400 text-[10px]"></i>
                      <span>Dono (<%= countOwner %>)</span>
                    </button>
                    <button type="button" onclick="setGuildRoleFilter('admin', this)" class="hardware-segmented-item">
                      <i class="fa-solid fa-shield-halved text-indigo-400 text-[10px]"></i>
                      <span>Admin (<%= countAdmin %>)</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Empty Search State -->
        <div id="no-guilds-found" class="hidden text-center py-16 panel-tone-indigo rounded-2xl max-w-md mx-auto laser-edge-indigo">
            <i class="fa-solid fa-folder-open text-3xl text-slate-600 mb-3"></i>
            <p class="text-sm text-slate-400 font-medium">Nenhum servidor encontrado com este termo ou filtro.</p>
            <button type="button" onclick="document.getElementById('guild-search-input').value=''; filterGuilds(''); setGuildRoleFilter('all', document.querySelector('#roleFilterControl .hardware-segmented-item'));" class="mt-4 text-xs text-indigo-400 hover:text-indigo-300 font-semibold">Limpar filtros</button>
        </div>

        <!-- Grid -->
        <div id="guilds-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
            <% guilds.forEach((guild, index) => { 
                const isOwner = !!guild.owner;
                let isAdmin = false;
                try {
                  const perms = BigInt(guild.permissions || 0);
                  isAdmin = (perms & 0x8n) === 0x8n;
                } catch (e) {
                  isAdmin = (Number(guild.permissions || 0) & 0x8) === 0x8;
                }
                const roleTag = isOwner ? 'dono owner' : (isAdmin ? 'admin administrador' : 'gerente manager');
                
                // Card class hierarchy
                const cardPanel = isOwner ? 'panel-tone-amber laser-edge-amber' : (isAdmin ? 'panel-tone-indigo laser-edge-indigo' : 'panel-chassis tonal-border-indigo');
                const borderAccent = isOwner ? 'border-amber-500/20' : (isAdmin ? 'border-indigo-500/20' : 'border-white/[0.04]');
                const btnClass = isOwner ? 'btn-studio-primary !bg-amber-600 hover:!bg-amber-500' : 'btn-studio-primary';
            %>
                <div class="guild-card-item <%= cardPanel %> rounded-2xl flex flex-col overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl relative group guild-card-stagger" data-name="<%= guild.name.toLowerCase() %>" data-id="<%= guild.id %>" data-role="<%= roleTag %>" style="animation-delay: <%= Math.min(index * 40, 480) %>ms">
                    
                    <!-- Role Badge & Bot Status -->
                    <div class="absolute top-3.5 left-3.5 z-20">
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold tracking-wider uppercase shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Pronto</span>
                      </span>
                    </div>

                    <div class="absolute top-3.5 right-3.5 z-20">
                      <% if (isOwner) { %>
                        <span class="badge-metallic-gold">
                          <i class="fa-solid fa-crown text-[9px]"></i>
                          <span>Dono</span>
                        </span>
                      <% } else if (isAdmin) { %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-indigo-500/15 border border-indigo-500/30 text-indigo-300 text-[10px] font-bold font-mono tracking-wider uppercase shadow-sm">
                          <i class="fa-solid fa-shield-halved text-[9px]"></i>
                          <span>Admin</span>
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.06] text-slate-400 text-[10px] font-medium tracking-wider">
                          <i class="fa-solid fa-user-gear text-[9px]"></i>
                          <span>Gerente</span>
                        </span>
                      <% } %>
                    </div>

                    <div class="p-5 sm:p-6 flex flex-col items-center flex-grow relative z-10">
                        <!-- Icon -->
                        <div class="relative mb-4 mt-3">
                            <div class="relative h-16 w-16 rounded-2xl overflow-hidden border <%= borderAccent %> shadow-lg group-hover:border-opacity-60 transition-colors duration-200 bg-black/40">
                              <!-- Skeleton placeholder -->
                              <div class="guild-icon-skeleton absolute inset-0 bg-white/[0.04] animate-pulse rounded-2xl"></div>
                              <img 
                                  class="w-full h-full object-cover relative z-10 group-hover:scale-105 transition-transform duration-300" 
                                  src="<%= guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png` : '/res/serverIcon/nonserverimg.jpg' %>" 
                                  onerror="this.onerror=null; this.src='/res/serverIcon/nonserverimg.jpg';"
                                  onload="const skel = this.previousElementSibling; if(skel) skel.style.display='none';"
                                  id="AguildIcon<%= guild.id %>"
                                  alt="<%= guild.name %> icon"
                                  loading="lazy"
                              />
                            </div>
                        </div>

                        <!-- Info -->
                        <h3 class="text-sm sm:text-base font-bold text-white mb-1 text-center line-clamp-1 w-full px-1 group-hover:text-<%= isOwner ? 'amber' : 'indigo' %>-200 transition-colors" title="<%= guild.name %>">
                            <%= guild.name %>
                        </h3>
                        <span class="px-2 py-0.5 rounded-md bg-black/30 border border-white/[0.03] text-[10px] font-mono text-slate-500 mb-5">
                            <%= guild.id %>
                        </span>

                        <!-- Action -->
                        <form action="/bot/botinfo" method="post" class="w-full mt-auto">
                            <input type="hidden" id="guilds" name="guilds" value="<%= guild.id %>"/>
                            <input type="hidden" id="nameofGuild" name="nameofGuild" value="<%= guild.name %>"/>
                            <input type="hidden" id="icon" name="icon" value="<%= (user && user.avatar) ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>"/>
                            
                            <button type="submit" class="<%= btnClass %> w-full !py-2.5 text-xs font-semibold rounded-xl flex items-center justify-center gap-2 transition-all">
                                <span>Gerenciar</span>
                                <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- Footer -->
        <div class="text-center mt-10 sm:mt-14 pt-6 border-t border-white/[0.04]">
            <p class="text-[10px] text-slate-600 font-mono tracking-widest uppercase flex items-center justify-center gap-2">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Manager Bot v1.5 • Sessão ativa • <%= guilds.length %> <%= guilds.length === 1 ? 'servidor' : 'servidores' %></span>
            </p>
        </div>
    </main>

    <style>
        .dashboard-header-enter {
            animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }
        .guild-card-stagger {
            animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }
        @keyframes fade-in-up {
            0% { opacity: 0; transform: translateY(16px) scale(0.98); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>

    <script>
      async function redirecionarParaRota(guildId) {
          try {
              const response = await fetch(`/bot/obter-icone-guilda/${guildId}`);
              if (!response.ok) return;
              const data = await response.json();
              const guildIcon = document.getElementById("AguildIcon" + guildId);
              if (guildIcon && data.iconURL) {
                  guildIcon.src = data.iconURL;
              }
          } catch (error) {
              console.error("Erro ao carregar imagem da guilda:", error);
          }
      }

      let currentSearchQuery = '';
      let currentRoleFilter = 'all';

      function setGuildRoleFilter(role, btn) {
          currentRoleFilter = role;
          document.querySelectorAll('#roleFilterControl .hardware-segmented-item').forEach(b => b.classList.remove('active'));
          if (btn) btn.classList.add('active');
          applyCombinedGuildFilter();
      }

      function filterGuilds(query) {
          currentSearchQuery = (query || '').toLowerCase().trim();
          applyCombinedGuildFilter();
      }

      function applyCombinedGuildFilter() {
          const cards = document.querySelectorAll('.guild-card-item');
          let visibleCount = 0;
          cards.forEach(card => {
              const name = card.getAttribute('data-name') || '';
              const id = card.getAttribute('data-id') || '';
              const role = card.getAttribute('data-role') || '';

              const matchesSearch = !currentSearchQuery || name.includes(currentSearchQuery) || id.includes(currentSearchQuery);
              let matchesRole = true;
              if (currentRoleFilter === 'owner') {
                  matchesRole = role.includes('owner');
              } else if (currentRoleFilter === 'admin') {
                  matchesRole = role.includes('admin') || role.includes('owner');
              }

              if (matchesSearch && matchesRole) {
                  card.style.display = '';
                  visibleCount++;
              } else {
                  card.style.display = 'none';
              }
          });
          const emptyState = document.getElementById('no-guilds-found');
          if (emptyState) {
              emptyState.classList.toggle('hidden', visibleCount > 0);
          }
      }

      window.onload = function() {
          document.querySelectorAll('.guild-card-item').forEach(card => {
              const guildId = card.getAttribute('data-id');
              const img = document.getElementById("AguildIcon" + guildId);
              if (img && img.src.includes('nonserverimg.jpg') && guildId) {
                  redirecionarParaRota(guildId);
              }
          });
      };

      document.addEventListener('keydown', function(e) {
          const input = document.getElementById('guild-search-input');
          if (!input) return;
          if (e.key === '/' && document.activeElement !== input) {
              e.preventDefault();
              input.focus();
              input.select();
          } else if (e.key === 'Escape' && document.activeElement === input) {
              input.value = '';
              filterGuilds('');
              input.blur();
          }
      });
    </script>
  </body>
</html>

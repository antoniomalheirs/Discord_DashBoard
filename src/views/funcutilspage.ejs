    <!-- Content -->
    <main class="relative z-10 flex-grow pt-28 sm:pt-36 pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
        <div class="mb-12 border-b border-indigo-500/20 pb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-slate-300 text-xs font-mono mb-4">
                <i class="fa-solid fa-layer-group text-indigo-400"></i>
                <span>Catálogo de Recursos & Módulos</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3">
                Funcionalidades & Automações
            </h1>
            <p class="text-sm sm:text-base text-slate-400 max-w-2xl leading-relaxed">
                Explore as capacidades do bot para transmissões, auditoria granular de moderação e economia da comunidade.

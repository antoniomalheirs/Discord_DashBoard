                    </div>
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-semibold uppercase tracking-wider">Ativo</span>
                </div>
                <h3 class="text-base font-bold text-white mb-2">Twitch Hub</h3>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">

                <a href="/auth/funcutils" class="px-4 py-1.5 rounded-full text-xs font-semibold text-white bg-white/[0.08] transition-all duration-150">Módulos & Funções</a>
                <a href="/auth/about" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Arquitetura</a>
                <a href="/auth/devs" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Comunidade</a>
            </div>

            <div class="flex items-center gap-3">
                <a href="/auth/discord" class="btn-studio-primary text-xs sm:text-sm !py-2 sm:!py-2.5 !px-4 sm:!px-5 rounded-xl">

        <div id="mobile-nav-dropdown" class="hidden lg:hidden border-t border-white/5 bg-[#090a0f]/95 backdrop-blur-2xl px-6 py-5 space-y-2">
            <a href="/auth/docs" class="block py-2.5 px-4 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all">Documentação</a>
            <a href="/auth/funcutils" class="block py-2.5 px-4 rounded-xl text-sm font-medium text-white bg-white/[0.08] transition-all">Módulos & Funções</a>
            <a href="/auth/about" class="block py-2.5 px-4 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all">Arquitetura</a>
            <a href="/auth/devs" class="block py-2.5 px-4 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all">Comunidade</a>

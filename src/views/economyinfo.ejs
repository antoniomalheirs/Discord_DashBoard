<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/cssdir/out.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Admin - Economia</title>
</head>

<body class="bg-transparent min-h-full flex items-start justify-center pt-10 px-4">
    <div class="bg-[#13151a]/80 backdrop-blur-xl border border-white/10 p-8 md:p-10 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.4)] w-full max-w-full animate-fade-in-up relative overflow-hidden">
        
        <!-- Background Decorators -->
        <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] bg-emerald-600/10 rounded-full blur-[100px] pointer-events-none"></div>

        <!-- Header -->
        <div class="flex flex-col md:flex-row items-center gap-6 mb-10 border-b border-white/5 pb-8 relative z-10">
            <div class="flex items-center justify-center w-16 h-16 bg-emerald-500/10 rounded-2xl border border-emerald-500/20 shadow-lg">
                <i class="fa-solid fa-coins text-3xl text-emerald-400"></i>
            </div>
            <div class="text-center md:text-left flex-1">
                <h3 class="text-3xl font-extrabold text-white mb-2 tracking-tight">Gestão Financeira</h3>
                <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
                    Gerencie o saldo em carteira e no banco dos membros da guilda <strong class="text-white"><%= info.name %></strong>.
                </p>
            </div>
        </div>

        <!-- Tabela -->
        <div class="relative z-10 bg-white/[0.02] border border-white/5 rounded-2xl overflow-hidden shadow-inner">
            <div class="overflow-x-auto">
                <table class="w-full text-left whitespace-nowrap">
                    <thead>
                        <tr class="bg-black/20 border-b border-white/5">
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Usuário</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Carteira</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Banco</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.05]">
                        <% if (info1.length === 0) { %>
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center justify-center opacity-50">
                                        <i class="fa-solid fa-wallet text-4xl mb-3 text-slate-500"></i>
                                        <p class="text-sm text-slate-400 font-medium">Nenhum dado financeiro encontrado.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                        <% info1.forEach(item => { %>
                            <tr class="hover:bg-white/[0.04] transition-colors duration-200 group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 text-indigo-400 font-bold">
                                            <%= item.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="font-bold text-white text-sm"><%= item.username %></div>
                                            <div class="text-[10px] text-slate-500 font-mono"><%= item.codigouser %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium shadow-inner">
                                        <i class="fa-solid fa-money-bill-wave text-[10px]"></i>
                                        $<%= (item.money || 0).toLocaleString() %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-mono font-medium shadow-inner">
                                        <i class="fa-solid fa-building-columns text-[10px]"></i>
                                        $<%= (item.bank || 0).toLocaleString() %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button onclick="openEditModal('<%= item.codigouser %>', '<%= item.username %>', '<%= item.money || 0 %>', '<%= item.bank || 0 %>')"
                                        class="opacity-0 group-hover:opacity-100 transition-all duration-300 inline-flex items-center justify-center gap-2 bg-indigo-600/80 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-lg hover:shadow-indigo-500/30 border border-indigo-500/50 hover:-translate-y-0.5">
                                        <i class="fa-solid fa-pen-to-square"></i> Editar
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal de Edição -->
    <div id="editModal" class="hidden fixed inset-0 z-[100] overflow-y-auto backdrop-blur-sm flex items-center justify-center" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Overlay -->
        <div class="fixed inset-0 bg-[#0b0c10]/80 transition-opacity" onclick="closeEditModal()"></div>

        <div class="relative bg-[#13151a] border border-white/10 rounded-3xl text-left overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.8)] transform transition-all max-w-md w-full mx-4 z-50 animate-fade-in-up">
            
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>

            <div class="p-8">
                <div class="mb-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20">
                        <i class="fa-solid fa-user-pen text-xl text-emerald-400"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">Editar Saldos</h3>
                        <p class="text-sm text-indigo-400 font-medium mt-0.5" id="modalUsername"></p>
                    </div>
                </div>

                <form action="/bot/update-economy" method="POST" class="space-y-5">
                    <input type="hidden" name="guildId" value="<%= info.id %>">
                    <input type="hidden" name="userId" id="modalUserId">

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Carteira ($)</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-solid fa-money-bill-wave text-emerald-500"></i>
                            </div>
                            <input type="number" name="money" id="modalMoney"
                                class="bg-black/40 border border-white/10 text-white text-sm rounded-xl focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full pl-11 py-3 transition-all shadow-inner font-mono">
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Banco ($)</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-solid fa-building-columns text-blue-500"></i>
                            </div>
                            <input type="number" name="bank" id="modalBank"
                                class="bg-black/40 border border-white/10 text-white text-sm rounded-xl focus:ring-1 focus:ring-blue-500 focus:border-blue-500 block w-full pl-11 py-3 transition-all shadow-inner font-mono">
                        </div>
                    </div>

                    <div class="pt-4 flex items-center gap-3 border-t border-white/5 mt-6">
                        <button type="button" onclick="closeEditModal()" class="flex-1 px-4 py-3 text-sm font-medium text-slate-300 bg-transparent hover:bg-white/5 rounded-xl border border-white/10 transition-colors">
                            Cancelar
                        </button>
                        <button type="submit" class="flex-1 px-4 py-3 text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl shadow-lg hover:shadow-emerald-500/30 border border-emerald-500/50 transition-all focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 focus:ring-offset-[#13151a]">
                            Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openEditModal(id, username, money, bank) {
            document.getElementById('modalUserId').value = id;
            document.getElementById('modalUsername').textContent = '@' + username;
            document.getElementById('modalMoney').value = money;
            document.getElementById('modalBank').value = bank;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>
    
    <style>
      @keyframes fade-in-up {
          0% { opacity: 0; transform: translateY(20px) scale(0.98); }
          100% { opacity: 1; transform: translateY(0) scale(1); }
      }
      .animate-fade-in-up {
          animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
</body>
</html>
                <span>gateway.ws</span>
              </button>
              <button type="button" onclick="switchHomeTab('json', this)" class="home-terminal-tab px-2.5 py-1 rounded-lg text-slate-400 hover:text-white border border-transparent flex items-center gap-1.5 transition-all cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                <span>audit_log.json</span>
              </button>
              <button type="button" onclick="switchHomeTab('sh', this)" class="home-terminal-tab px-2.5 py-1 rounded-lg text-slate-400 hover:text-white border border-transparent flex items-center gap-1.5 transition-all cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                <span>stream_event.sh</span>
              </button>
            </div>

            <!-- Copy Code Button -->
            <button type="button" onclick="copyTerminalContent(this)" class="px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-white text-[11px] flex items-center gap-1.5 transition-colors cursor-pointer ml-auto">
              <i class="fa-regular fa-copy text-[10px]"></i>
              <span id="copy-terminal-label">Copiar</span>
            </button>
          </div>

          <!-- Tab Content 1: gateway.ws -->
          <div id="home-tab-ws" class="home-tab-pane p-5 space-y-2 text-slate-300 select-text overflow-x-auto custom-table-scroll leading-relaxed">
            <div class="text-slate-500 font-mono text-[11px]"># Conexão contínua com Discord Gateway API v10</div>
            <div><span class="text-slate-500">[00:00:01]</span> <span class="text-cyan-400 font-semibold">WS_CONNECT:</span> <span class="text-slate-300">wss://gateway.discord.gg/?v=10&encoding=json</span></div>
            <div><span class="text-slate-500">[00:00:02]</span> <span class="text-indigo-400 font-semibold">HELLO:</span> <span class="text-slate-300">heartbeat_interval = 41250ms</span></div>
            <div><span class="text-slate-500">[00:00:02]</span> <span class="text-amber-400 font-semibold">IDENTIFY:</span> <span class="text-slate-300">intents = 3276799 (Guilds, Voice, Messages, Members)</span></div>
            <div><span class="text-slate-500">[00:00:03]</span> <span class="text-emerald-400 font-semibold">READY:</span> <span class="text-slate-300">session_id = "d89a24cf..." (autenticado em 24ms)</span></div>
            <div><span class="text-slate-500">[00:00:04]</span> <span class="text-emerald-400 font-semibold">RESUMED:</span> <span class="text-emerald-300">0 pacotes perdidos • Latência: 18ms</span></div>
            <div class="pt-2 flex items-center gap-2 text-slate-400">
              <span class="text-emerald-400">manager@studio:~$</span>
              <span class="text-white">bot.status --all-shards</span>
            </div>
            <div class="text-slate-400 pl-4 border-l border-white/10 mt-1">
              [SHARD 0] Ping: 18ms • Guilds: 48 • Memory: 142MB <span class="text-emerald-400 font-semibold">[OPERACIONAL]</span>
            </div>
          </div>

          <!-- Tab Content 2: audit_log.json -->
          <div id="home-tab-json" class="home-tab-pane hidden p-5 space-y-1 text-slate-300 select-text overflow-x-auto custom-table-scroll text-xs">
            <pre class="font-mono text-xs leading-relaxed"><span class="text-slate-500">{</span>
  <span class="text-indigo-400">"event"</span>: <span class="text-emerald-300">"MESSAGE_DELETE"</span>,
  <span class="text-indigo-400">"timestamp"</span>: <span class="text-emerald-300">"2026-09-18T00:30:15.120Z"</span>,
  <span class="text-indigo-400">"guild_id"</span>: <span class="text-amber-300">"1407885636135944342"</span>,
  <span class="text-indigo-400">"channel_id"</span>: <span class="text-amber-300">"1049284729103948291"</span>,
  <span class="text-indigo-400">"author"</span>: <span class="text-slate-500">{</span> <span class="text-indigo-400">"id"</span>: <span class="text-amber-300">"4920491829"</span>, <span class="text-indigo-400">"tag"</span>: <span class="text-emerald-300">"@membro#1337"</span> <span class="text-slate-500">}</span>,
  <span class="text-indigo-400">"audit_dispatcher"</span>: <span class="text-slate-500">{</span>
    <span class="text-indigo-400">"action"</span>: <span class="text-emerald-300">"actlog_message_delete"</span>,
    <span class="text-indigo-400">"target_channel"</span>: <span class="text-emerald-300">"#logs-auditoria"</span>,
    <span class="text-indigo-400">"status"</span>: <span class="text-emerald-400">"DISPATCHED_O(1)"</span>
  <span class="text-slate-500">}</span>
<span class="text-slate-500">}</span></pre>
          </div>

          <!-- Tab Content 3: stream_event.sh -->
          <div id="home-tab-sh" class="home-tab-pane hidden p-5 space-y-1 text-slate-300 select-text overflow-x-auto custom-table-scroll text-xs">
            <pre class="font-mono text-xs leading-relaxed text-slate-300"><span class="text-slate-500"># Webhook Dispatcher Pipeline v1.5.0</span>
<span class="text-indigo-400">curl</span> -X POST <span class="text-emerald-300">"https://discord.com/api/v10/channels/104928/messages"</span> \
  -H <span class="text-amber-300">"Authorization: Bot $DISCORD_TOKEN"</span> \
  -H <span class="text-amber-300">"Content-Type: application/json"</span> \
  -d <span class="text-slate-300">'{
    "embeds": [{
      "title": "🔴 AO VIVO NA TWITCH",
      "description": "Streamer iniciou transmissão ao vivo!",
      "color": 9520895
    }]
  }'</span>
<span class="text-emerald-400"># [OK 200] Alerta entregue em 42ms sem recarregar a tela</span></pre>
          </div>
        </div>

        <!-- Feature Highlights (Studio Cards) -->
        <div class="mt-20 sm:mt-24 grid grid-cols-1 md:grid-cols-3 gap-5 max-w-6xl mx-auto w-full px-2">
            <!-- Card 1 -->
            <div class="panel-elevated rounded-2xl p-6 sm:p-7 hover:border-white/[0.14] transition-all duration-200 laser-edge-top card-accent-youtube">
                <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center border border-red-500/20 mb-5 text-red-400">

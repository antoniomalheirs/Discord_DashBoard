    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.06] py-8 text-center text-xs text-slate-500 relative z-10">
        <p>Manager Bot © 2026 • Construído com Node.js, Express e Discord.js v14</p>
    </footer>

    <script>
        function toggleNavMenu() {
            const menu = document.getElementById("mobile-nav-dropdown");
            const icon = document.getElementById("nav-toggle-icon");
            if (!menu || !icon) return;

            const isHidden = menu.classList.contains("hidden");
            if (isHidden) {
                menu.classList.remove("hidden");
                icon.classList.remove("fa-bars");
                icon.classList.add("fa-xmark");
            } else {
                menu.classList.add("hidden");
                icon.classList.remove("fa-xmark");
                icon.classList.add("fa-bars");
            }
        }

        let currentActiveTab = 'ws';

        function switchHomeTab(tab, btn) {
            currentActiveTab = tab;
            document.querySelectorAll('.home-terminal-tab').forEach(b => {
                b.classList.remove('active', 'text-white', 'bg-white/[0.08]', 'border-white/[0.1]');
                b.classList.add('text-slate-400', 'border-transparent');
            });
            if (btn) {
                btn.classList.add('active', 'text-white', 'bg-white/[0.08]', 'border-white/[0.1]');
                btn.classList.remove('text-slate-400', 'border-transparent');
            }
            document.querySelectorAll('.home-tab-pane').forEach(p => p.classList.add('hidden'));
            const targetPane = document.getElementById('home-tab-' + tab);
            if (targetPane) targetPane.classList.remove('hidden');
        }

        function copyTerminalContent(btn) {
            const activePane = document.getElementById('home-tab-' + currentActiveTab);
            if (!activePane) return;
            const textToCopy = (activePane.innerText || activePane.textContent || "").trim();
            
            const notifyCopied = () => {
                const label = document.getElementById('copy-terminal-label');
                if (label) {
                    const prev = label.textContent;
                    label.textContent = 'Copiado!';
                    label.classList.add('text-emerald-400');
                    setTimeout(() => {
                        label.textContent = prev;
                        label.classList.remove('text-emerald-400');
                    }, 1800);
                }
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(textToCopy).then(notifyCopied).catch(() => {
                    fallbackHomeCopy(textToCopy, notifyCopied);
                });
            } else {
                fallbackHomeCopy(textToCopy, notifyCopied);
            }
        }

        function fallbackHomeCopy(text, callback) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            try {
                document.execCommand("copy");
                if (typeof callback === "function") callback();
            } catch (e) {
                console.error("Falha ao copiar:", e);
            }
            document.body.removeChild(ta);
        }
    </script>
</body>
</html>

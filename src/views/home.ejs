            </div>
            
            <!-- Card 2 -->
            <div class="panel-elevated rounded-2xl p-6 sm:p-7 hover:border-white/[0.14] transition-all duration-200 laser-edge-top card-accent-indigo">
                <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 mb-5 text-indigo-400">
                    <i class="fa-solid fa-shield-halved text-base"></i>
                </div>
                <h3 class="text-base font-semibold text-white mb-2 tracking-tight">Central de Auditoria</h3>
                <p class="text-slate-400 leading-relaxed text-xs sm:text-sm">Rastreamento de 11 eventos de moderação (mensagens deletadas/editadas, movimentação de voz, bans, cargos) com controle individual.</p>
            </div>

            <!-- Card 3 -->
            <div class="panel-elevated rounded-2xl p-6 sm:p-7 hover:border-white/[0.14] transition-all duration-200 laser-edge-top card-accent-emerald">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20 mb-5 text-emerald-400">
                    <i class="fa-solid fa-coins text-base"></i>
                </div>
                <h3 class="text-base font-semibold text-white mb-2 tracking-tight">Comunidade & Economia</h3>
                <p class="text-slate-400 leading-relaxed text-xs sm:text-sm">Busca instantânea de membros, ranking por tempo em voz e mensagens, e gerenciador de saldos bancários com feedback em Toasts.</p>
            </div>

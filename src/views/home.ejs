                <a href="/auth/funcutils" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Módulos & Funções</a>
                <a href="/auth/about" class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.05] transition-all duration-150">Arquitetura</a>

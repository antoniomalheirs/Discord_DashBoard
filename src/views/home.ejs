        <!-- Hardware Terminal Multi-Tab Interactive Mockup -->
        <div class="mt-14 max-w-3xl w-full mx-auto relative rounded-2xl overflow-hidden border border-white/[0.12] shadow-2xl bg-[#0b0e17] laser-edge-top text-left font-mono text-xs">

                </div>
                <span class="font-semibold text-sm">Estatísticas</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="guild-chevron"></i>
            </div>
            <div id="guild-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-indigo-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('server')">
                <span class="relative z-10">Dashboard</span>
              </div>
              <div class="menu-subitem group" onclick="selectTopic('status')">
                <span class="relative z-10">Status do Bot</span>
              </div>
              <div class="menu-subitem group" onclick="selectTopic('statesinfo')">
                <span class="relative z-10">Módulos Ativos</span>
              </div>
            </div>
          </div>
        </div>

        <!-- FUNCTIONS SECTION -->
        <div id="functions-sidebar" class="sidebar-section hidden">
          <div class="text-[10px] font-bold text-emerald-400/80 uppercase px-3 mb-2 tracking-widest mt-2">Features</div>

          <!-- Socials -->
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('funcs')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-emerald-500/10 flex items-center justify-center group-hover:bg-emerald-500/20 transition-colors">
                  <i class="fa-solid fa-share-nodes text-emerald-400 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Notificações</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="funcs-chevron"></i>
            </div>
            <div id="funcs-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-emerald-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('funcyoutube')">
                <span class="relative z-10 flex items-center gap-2"><i class="fa-brands fa-youtube text-red-500"></i> YouTube</span>
              </div>
              <div class="menu-subitem group" onclick="selectTopic('functwitch')">
                <span class="relative z-10 flex items-center gap-2"><i class="fa-brands fa-twitch text-purple-500"></i> Twitch</span>
              </div>
            </div>
          </div>

          <!-- Entertainment -->
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('fun')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-pink-500/10 flex items-center justify-center group-hover:bg-pink-500/20 transition-colors">
                  <i class="fa-solid fa-gamepad text-pink-400 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Diversão</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="fun-chevron"></i>
            </div>
            <div id="fun-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-pink-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('funcpoker')">
                <span class="relative z-10 flex items-center gap-2"><i class="fa-solid fa-cards text-pink-400"></i> Poker</span>
              </div>
            </div>
          </div>
        </div>

        <!-- DATABASE SECTION -->
        <div id="guildDB-sidebar" class="sidebar-section hidden">
          <div class="text-[10px] font-bold text-amber-400/80 uppercase px-3 mb-2 tracking-widest mt-2">Dados</div>

          <!-- Youtube DB -->
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('guilddbyt')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-red-500/10 flex items-center justify-center group-hover:bg-red-500/20 transition-colors">
                  <i class="fa-brands fa-youtube text-red-500 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Canais YouTube</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="guilddbyt-chevron"></i>
            </div>
            <div id="guilddbyt-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-red-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('addytbchannel')">Adicionar</div>
              <div class="menu-subitem group" onclick="selectTopic('viewytbchannels')">Visualizar Lista</div>
              <div class="menu-subitem group text-red-400 hover:text-red-300" onclick="selectTopic('deleteytbchannels')">Remover</div>
            </div>
          </div>

          <!-- Twitch DB -->
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('guilddbtwh')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-purple-500/10 flex items-center justify-center group-hover:bg-purple-500/20 transition-colors">
                  <i class="fa-brands fa-twitch text-purple-500 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Canais Twitch</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="guilddbtwh-chevron"></i>
            </div>
            <div id="guilddbtwh-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-purple-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('addtchchannel')">Adicionar</div>
              <div class="menu-subitem group" onclick="selectTopic('viewtchchannel')">Visualizar Lista</div>
              <div class="menu-subitem group text-red-400 hover:text-red-300" onclick="selectTopic('deletetchchannel')">Remover</div>
            </div>
          </div>
        </div>

        <!-- SERVER INFO SECTION -->
        <div id="serverInfos-sidebar" class="sidebar-section hidden">
          <div class="text-[10px] font-bold text-sky-400/80 uppercase px-3 mb-2 tracking-widest mt-2">Comunidade</div>
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('users')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-sky-500/10 flex items-center justify-center group-hover:bg-sky-500/20 transition-colors">
                  <i class="fa-solid fa-users text-sky-400 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Usuários</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="users-chevron"></i>
            </div>
            <div id="users-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-sky-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('memberinfo')">Classificações</div>
              <div class="menu-subitem group text-amber-400 hover:text-amber-300" onclick="selectTopic('economyinfo')"><i class="fa-solid fa-coins mr-1"></i> Economia</div>
            </div>
          </div>
        </div>

        <!-- CONFIG SECTION -->
        <div id="config-sidebar" class="sidebar-section hidden">
          <div class="text-[10px] font-bold text-slate-400/80 uppercase px-3 mb-2 tracking-widest mt-2">Administração</div>
          
          <div class="menu-item-group mb-2">
            <div class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
              onclick="toggleDropdown('config')">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-slate-500/10 flex items-center justify-center group-hover:bg-slate-500/20 transition-colors">
                  <i class="fa-solid fa-bullhorn text-slate-400 text-sm"></i>
                </div>
                <span class="font-semibold text-sm">Avisos e Canais</span>
              </div>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-500 transition-transform duration-300 group-hover:text-slate-300" id="config-chevron"></i>
            </div>
            <div id="config-dropdown" class="pl-5 mt-1 ml-3 border-l-2 border-slate-500/20 space-y-1 overflow-hidden transition-all duration-300">
              <div class="menu-subitem group" onclick="selectTopic('ytbchannelupdate')">Avisos do YouTube</div>
              <div class="menu-subitem group" onclick="selectTopic('tchchannelupdate')">Avisos da Twitch</div>
            </div>
          </div>
        </div>

      </div>

      <!-- User Profile (Bottom Fixed) -->
      <div class="mt-auto bg-[#0b0c10]/80 backdrop-blur-md border-t border-white/5 p-4">
        <div class="flex items-center gap-3 hover:bg-white/5 p-2 rounded-xl cursor-pointer transition-all duration-300 relative group border border-transparent hover:border-white/10 shadow-lg"
          onclick="togglebtnDropdown('minhaImagem')" id="minhaImagem">
          <img class="h-10 w-10 rounded-full border-2 border-white/10 group-hover:border-indigo-500 transition-all shadow-[0_0_10px_rgba(0,0,0,0.3)] group-hover:shadow-[0_0_15px_rgba(99,102,241,0.5)]"
            src="" alt="User" id="user-avatar-img">
          <div class="flex flex-col overflow-hidden">
            <span id="userpt"
              class="text-sm font-bold text-white truncate group-hover:text-indigo-400 transition-colors">User</span>
            <span id="email" class="text-xs text-slate-500 truncate">email@ex.com</span>
          </div>

          <!-- User Dropdown (Upwards) -->
          <div id="minhaImagem-changeState"
            class="hidden absolute bottom-[110%] left-0 w-56 mb-2 bg-[#1a1d24]/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.5)] z-50 overflow-hidden transform origin-bottom-left transition-all">
            <a href="/dashboard" class="block px-4 py-3 text-sm text-slate-300 hover:bg-white/5 hover:text-white transition-colors border-b border-white/5">
              <i class="fa-solid fa-table-cells-large w-5"></i> Meus Servidores
            </a>
            <a href="/" class="block px-4 py-3 text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-colors">
              <i class="fa-solid fa-power-off w-5"></i> Desconectar
            </a>
          </div>
        </div>
      </div>
    </aside>

    <!-- TOP BAR (Breadcrumbs & Search) -->
    <header
      class="fixed top-0 left-84 right-0 h-16 bg-[#0f1115]/80 backdrop-blur-md border-b border-white/5 flex items-center justify-between px-8 z-30 transition-all duration-300 shadow-sm"
      style="left: 21.5rem;">
      <!-- Breadcrumbs -->
      <div class="flex items-center text-slate-400 text-sm font-medium bg-white/5 px-4 py-2 rounded-full border border-white/5 shadow-inner">
        <i class="fa-solid fa-map-location-dot mr-3 text-indigo-400"></i>
        <span id="hashtag-home" class="text-slate-300">Início</span>
        <span id="hashtag-functions" class="hidden text-slate-300">Módulos</span>
        <span id="hashtag-guildDB" class="hidden text-slate-300">Banco de Dados</span>
        <span id="hashtag-serverInfos" class="hidden text-slate-300">Comunidade</span>
        <span id="hashtag-config" class="hidden text-slate-300">Configurações</span>
      </div>

      <!-- Search -->
      <div class="relative group">
        <input type="text" placeholder="Buscar configurações..."
          class="bg-[#1a1d24]/80 border border-white/10 text-white text-sm rounded-full px-5 py-2 pl-11 focus:outline-none focus:border-indigo-500/50 focus:ring-2 focus:ring-indigo-500/20 w-72 transition-all placeholder-slate-500 group-hover:border-white/20 shadow-inner">
        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-400 transition-colors"></i>
      </div>
    </header>

  </div>

  <!-- STYLES FOR SUBITEMS -->
  <style>
    .menu-subitem {
      position: relative;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      color: #94a3b8;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: all 0.3s;
      display: block;
      user-select: none;
      overflow: hidden;
    }
    .menu-subitem:hover {
      color: #ffffff;
      padding-left: 1.5rem;
    }
    .menu-subitem::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 0;
      background-color: rgba(255, 255, 255, 0.05);
      transition: all 0.3s;
      z-index: 0;
      border-radius: 0.5rem;
    }
    .menu-subitem:hover::before {
      width: 100%;
    }
    .menu-subitem::after {
      content: '';
      position: absolute;
      left: 0.5rem;
      top: 50%;
      transform: translateY(-50%);
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 9999px;
      background-color: #475569;
      transition: all 0.3s;
      opacity: 0;
    }
    .menu-subitem:hover::after {
      opacity: 1;
      background-color: currentColor;
      box-shadow: 0 0 8px currentColor;
    }
    .animate-spin-slow {
      animation: spin 6s linear infinite;
    }
  </style>

  <!-- SCRIPTS -->
  <script>
    // Load parent data
    try {
      var img = parent.user();
      var email = parent.email();
      var user = parent.username();
      const serverName = parent.guildName();

      document.getElementById("server-name").textContent = serverName;
      document.getElementById("email").textContent = email;
      document.getElementById("userpt").textContent = user;
      document.getElementById("user-avatar-img").src = img;
    } catch (e) {
      console.log("Not loaded inside parent frame or error fetching parent data");
    }

    function handleIconClick(btnId) {
      // Hide all sections
      const sections = ['home', 'functions', 'guildDB', 'serverInfos', 'config'];
      sections.forEach(sec => {
        const sidebar = document.getElementById(`${sec}-sidebar`);
        const hashtag = document.getElementById(`hashtag-${sec}`);
        if (sidebar) {
            sidebar.classList.add('hidden');
            sidebar.classList.remove('animate-fade-in-up');
        }
        if (hashtag) hashtag.classList.add('hidden');
      });

      // Show selected with animation
      const selectedSidebar = document.getElementById(`${btnId}-sidebar`);
      const selectedHashtag = document.getElementById(`hashtag-${btnId}`);
      if (selectedSidebar) {
          selectedSidebar.classList.remove('hidden');
          // Forçar reflow para reiniciar animação
          void selectedSidebar.offsetWidth;
          selectedSidebar.classList.add('animate-fade-in-up');
      }
      if (selectedHashtag) selectedHashtag.classList.remove('hidden');
    }

    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId + "-dropdown");
      const chevron = document.getElementById(dropdownId + "-chevron");
      
      if (dropdown.classList.contains('hidden')) {
        dropdown.classList.remove('hidden');
        if(chevron) chevron.style.transform = 'rotate(180deg)';
      } else {
        dropdown.classList.add('hidden');
        if(chevron) chevron.style.transform = 'rotate(0deg)';
      }
    }

    function togglebtnDropdown(btnId) {
      const dropdown = document.getElementById(btnId + "-changeState");
      dropdown.classList.toggle("hidden");
    }

    function selectTopic(topic) {
      console.log("[Sidebar] Selecting topic:", topic);

      if (typeof carregarConteudo === 'function') {
        carregarConteudo(topic);
      } else if (window.carregarConteudo && typeof window.carregarConteudo === 'function') {
        window.carregarConteudo(topic);
      } else if (parent && typeof parent.carregarConteudo === 'function') {
        parent.carregarConteudo(topic);
      } else {
        console.error("Critical Error: carregarConteudo function not found.");
      }
    }
  </script>
</body>
</html>
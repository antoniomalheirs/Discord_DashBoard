<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <link href="../css/cssdir/out.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sidebar</title>
</head>

<body class="bg-transparent font-sans text-gray-300">

  <!-- MAIN CONTAINER -->
  <div class="flex h-screen w-full">

    <!-- 1. PRIMARY SIDEBAR (Icon Rail) -->
    <nav id="sidebar"
      class="w-20 bg-[#0b0c10]/90 backdrop-blur-xl flex flex-col items-center py-6 border-r border-white/5 z-50 shadow-2xl h-screen fixed left-0 top-0 overflow-y-auto scrollbar-hide">
      
      <!-- Home Icon -->
      <div class="relative group mb-6">
        <div class="absolute -left-4 top-1/2 -translate-y-1/2 h-8 w-1 bg-indigo-500 rounded-r-md transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-[0_0_15px_rgba(99,102,241,0.8)]"></div>
        <div id="home" onclick="handleIconClick('home')"
          class="h-12 w-12 rounded-[20px] group-hover:rounded-[14px] bg-white/5 group-hover:bg-gradient-to-br group-hover:from-indigo-500 group-hover:to-purple-600 transition-all duration-300 cursor-pointer flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(99,102,241,0.5)] border border-white/10 group-hover:border-transparent transform group-hover:-translate-y-1">
          <i class="fa-solid fa-house text-xl text-slate-300 group-hover:text-white transition-colors"></i>
        </div>
        <!-- Tooltip -->
        <div class="absolute left-16 top-1/2 -translate-y-1/2 bg-[#1a1d24] text-white text-xs font-bold px-3 py-2 rounded-md opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none shadow-xl border border-white/10 whitespace-nowrap z-50 translate-x-2 group-hover:translate-x-0">
          Início
        </div>
      </div>

      <div class="w-8 h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent mb-6"></div>

      <!-- Functions Group -->
      <div class="flex flex-col gap-5">
        
        <!-- Modules Icon -->
        <div class="relative group">
          <div class="absolute -left-4 top-1/2 -translate-y-1/2 h-8 w-1 bg-emerald-500 rounded-r-md transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-[0_0_15px_rgba(16,185,129,0.8)]"></div>
          <div id="functions" onclick="handleIconClick('functions')"
            class="h-12 w-12 rounded-[20px] group-hover:rounded-[14px] bg-white/5 group-hover:bg-gradient-to-br group-hover:from-emerald-400 group-hover:to-teal-600 transition-all duration-300 cursor-pointer flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(16,185,129,0.5)] border border-white/10 group-hover:border-transparent transform group-hover:-translate-y-1">
            <i class="fa-solid fa-cube text-xl text-slate-300 group-hover:text-white transition-colors"></i>
          </div>
          <div class="absolute left-16 top-1/2 -translate-y-1/2 bg-[#1a1d24] text-white text-xs font-bold px-3 py-2 rounded-md opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none shadow-xl border border-white/10 whitespace-nowrap z-50 translate-x-2 group-hover:translate-x-0">
            Módulos
          </div>
        </div>

        <!-- Database Icon -->
        <div class="relative group">
          <div class="absolute -left-4 top-1/2 -translate-y-1/2 h-8 w-1 bg-amber-500 rounded-r-md transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-[0_0_15px_rgba(245,158,11,0.8)]"></div>
          <div id="guildDB" onclick="handleIconClick('guildDB')"
            class="h-12 w-12 rounded-[20px] group-hover:rounded-[14px] bg-white/5 group-hover:bg-gradient-to-br group-hover:from-amber-400 group-hover:to-orange-600 transition-all duration-300 cursor-pointer flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(245,158,11,0.5)] border border-white/10 group-hover:border-transparent transform group-hover:-translate-y-1">
            <i class="fa-solid fa-database text-xl text-slate-300 group-hover:text-white transition-colors"></i>
          </div>
          <div class="absolute left-16 top-1/2 -translate-y-1/2 bg-[#1a1d24] text-white text-xs font-bold px-3 py-2 rounded-md opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none shadow-xl border border-white/10 whitespace-nowrap z-50 translate-x-2 group-hover:translate-x-0">
            Banco de Dados
          </div>
        </div>

        <!-- Server Info Icon -->
        <div class="relative group">
          <div class="absolute -left-4 top-1/2 -translate-y-1/2 h-8 w-1 bg-sky-500 rounded-r-md transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-[0_0_15px_rgba(14,165,233,0.8)]"></div>
          <div id="serverInfos" onclick="handleIconClick('serverInfos')"
            class="h-12 w-12 rounded-[20px] group-hover:rounded-[14px] bg-white/5 group-hover:bg-gradient-to-br group-hover:from-sky-400 group-hover:to-blue-600 transition-all duration-300 cursor-pointer flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(14,165,233,0.5)] border border-white/10 group-hover:border-transparent transform group-hover:-translate-y-1">
            <i class="fa-solid fa-users text-xl text-slate-300 group-hover:text-white transition-colors"></i>
          </div>
          <div class="absolute left-16 top-1/2 -translate-y-1/2 bg-[#1a1d24] text-white text-xs font-bold px-3 py-2 rounded-md opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none shadow-xl border border-white/10 whitespace-nowrap z-50 translate-x-2 group-hover:translate-x-0">
            Comunidade
          </div>
        </div>

      </div>

      <div class="w-8 h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent my-6"></div>

      <!-- Config Icon -->
      <div class="relative group">
        <div class="absolute -left-4 top-1/2 -translate-y-1/2 h-8 w-1 bg-slate-400 rounded-r-md transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-[0_0_15px_rgba(148,163,184,0.8)]"></div>
        <div id="config" onclick="handleIconClick('config')"
          class="h-12 w-12 rounded-[20px] group-hover:rounded-[14px] bg-white/5 group-hover:bg-gradient-to-br group-hover:from-slate-400 group-hover:to-slate-600 transition-all duration-300 cursor-pointer flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(148,163,184,0.5)] border border-white/10 group-hover:border-transparent transform group-hover:-translate-y-1">
          <i class="fa-solid fa-gear text-xl text-slate-300 group-hover:text-white transition-colors group-hover:animate-spin-slow"></i>
        </div>
        <div class="absolute left-16 top-1/2 -translate-y-1/2 bg-[#1a1d24] text-white text-xs font-bold px-3 py-2 rounded-md opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none shadow-xl border border-white/10 whitespace-nowrap z-50 translate-x-2 group-hover:translate-x-0">
          Configurações
        </div>
      </div>

    </nav>


    <!-- 2. SECONDARY SIDEBAR (Context Actions) -->
    <aside id="server-bar"
      class="w-64 bg-[#0f1115]/95 backdrop-blur-3xl flex flex-col h-screen fixed left-20 top-0 border-r border-white/5 shadow-2xl z-40 overflow-y-auto">

      <!-- Server Header -->
      <div class="h-16 flex items-center px-5 border-b border-white/5 bg-gradient-to-r from-indigo-500/10 to-transparent sticky top-0 z-10 backdrop-blur-md">
        <h5 id="server-name" class="text-white font-bold text-lg truncate drop-shadow-sm tracking-wide">
          Carregando...
        </h5>
      </div>

      <!-- Dynamic Content Area -->
      <div class="p-4 space-y-1">

        <!-- HOME SECTION -->
        <div id="home-sidebar" class="sidebar-section">
          <div class="text-[10px] font-bold text-indigo-400/80 uppercase px-3 mb-2 tracking-widest mt-2">Visão Geral</div>

          <div class="menu-item-group mb-2">
            <div
              class="menu-header flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-white/5 cursor-pointer transition-all duration-300 text-slate-300 hover:text-white group border border-transparent hover:border-white/10"
